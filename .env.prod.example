# Production environment for docker-compose.prod.yml on EC2.
# Copy to `.env.prod` and fill in real values. NEVER commit `.env.prod`.
#
#   cp .env.prod.example .env.prod

# ---------- Database (cloud-hosted, e.g. Neon) ----------
DATABASE_URL="postgresql://user:password@your-neon-host/dbname?sslmode=require"

# ---------- JWT ----------
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# ---------- CORS ----------
# Your EC2 public domain / IP (the one users hit in the browser)
CORS_ORIGIN=http://your-ec2-domain-or-ip

# ---------- Security ----------
BCRYPT_ROUNDS=10

# ---------- Rate Limiting ----------
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=500

# ---------- Database Pool ----------
# Keep modest on a small EC2 instance; Neon's pooler also caps concurrent conns.
DB_POOL_MIN=2
DB_POOL_MAX=20

# ---------- Redis (cloud-hosted, e.g. Redis Cloud) ----------
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# ---------- AWS S3 (file storage) ----------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=your-bucket-name

# ---------- Publication Sync ----------
PUBLICATION_SYNC_ENABLED=true
PUBLICATION_SYNC_CRON=0 2 * * *

# ---------- ORCID ----------
ORCID_API_BASE_URL=https://pub.orcid.org/v3.0
ORCID_ACCESS_TOKEN=

# ---------- OpenAlex ----------
OPENALEX_API_BASE_URL=https://api.openalex.org
OPENALEX_API_KEY=your-openalex-key

# ---------- Crossref ----------
CROSSREF_API_BASE_URL=https://api.crossref.org

# ---------- Scopus (optional) ----------
SCOPUS_API_BASE_URL=https://api.elsevier.com/content
SCOPUS_API_KEY=

# ---------- Software Licensing & Hardware DRM ----------
LICENSE_KEY=your-production-or-assigned-license-key
LICENSE_SERVER_URL=https://sgt-ums-2.onrender.com/api/v1/license/verify
LICENSE_SALT=your-master-license-salt
LICENSE_WHITELIST_LOCAL=false
