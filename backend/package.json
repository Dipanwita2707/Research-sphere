{
  "name": "sgt-ums-backend",
  "version": "1.0.0",
  "description": "SGT University Management System - Backend API",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "node src/shared/database/seed.js",
    "seed:superadmin": "node scripts/database/seeds/seed-superadmin.js",
    "seed:research-policy": "node scripts/database/seeds/seed-research-policy-updated.js",
    "seed:conference-policies": "node scripts/database/seeds/seed-conference-policy-not-indexed.js",
    "build:protect": "javascript-obfuscator src/shared/utils/licensing.js --output dist/licensing.protected.js --compact true --self-defending true --string-array true --string-array-encoding rc4",
    "build:protected": "node scripts/build-protected-dist.js",
    "test": "jest"
  },
  "keywords": [
    "university",
    "management",
    "system"
  ],
  "author": "SGT University",
  "license": "PROPRIETARY",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@aws-sdk/lib-storage": "^3.1144.0",
    "@aws-sdk/s3-request-presigner": "^3.1144.0",
    "@prisma/client": "^5.22.0",
    "@sendgrid/helpers": "^8.0.0",
    "@sendgrid/mail": "^8.1.6",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/multer": "^2.3.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.11",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^18.0.5",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.13.0",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "multer-s3": "^3.0.1",
    "node-cron": "^4.6.0",
    "node-machine-id": "^1.1.12",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "sanitize-html": "^2.18.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "winston": "^3.19.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "axios": "^1.20.0",
    "javascript-obfuscator": "^5.8.1",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prisma": "^5.19.0"
  },
  "overrides": {
    "test-exclude": "^8",
    "exceljs": {
      "fast-csv": "^5",
      "unzipper": "^0.12",
      "uuid": "^11"
    },
    "archiver-utils": {
      "glob": "^13"
    }
  }
}
