{
  "name": "sgt-ums-backend",
  "version": "1.0.0",
  "description": "SGT University Management System - Backend API",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "node src/shared/database/seed.js",
    "seed:admin": "node scripts/database/seeds/seed-admin.js",
    "cleanup:noting": "node scripts/cleanup-noting.js",
    "migrate:noting-view-key": "node scripts/migrate-noting-view-permission-key.js",
    "build:protect": "javascript-obfuscator src/shared/utils/licensing.js --output dist/licensing.protected.js --compact true --self-defending true --string-array true --string-array-encoding rc4",
    "build:protected": "node scripts/build-protected-dist.js",
    "test": "jest"
  },
  "keywords": [
    "university",
    "management",
    "system"
  ],
  "author": "SGT University",
  "license": "PROPRIETARY",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.981.0",
    "@aws-sdk/lib-storage": "^3.981.0",
    "@aws-sdk/s3-request-presigner": "^3.981.0",
    "@prisma/client": "^5.22.0",
    "@sendgrid/helpers": "^8.0.0",
    "@sendgrid/mail": "^8.1.6",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/multer": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.70.4",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.9.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "multer-s3": "^3.0.1",
    "node-cron": "^4.2.1",
    "node-machine-id": "^1.1.12",
    "nodemailer": "^8.0.5",
    "pg": "^8.16.3",
    "sanitize-html": "^2.17.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.0",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "axios": "^1.13.6",
    "javascript-obfuscator": "^5.6.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prisma": "^5.19.0"
  }
}
