// Custom fields configured by event organizer
model EventCustomField {
  id                String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  eventId           String
  fieldName         String                @map("field_name") @db.VarChar(128)
  fieldLabel        String                @map("field_label") @db.VarChar(256)
  fieldType         EventFieldType        @map("field_type")
  isRequired        Boolean               @default(false) @map("is_required")
  placeholder       String?               @db.VarChar(256)
  helpText          String?               @map("help_text") @db.VarChar(512)
  options           Json?                                                          // For dropdown/radio/checkbox options
  validationRules   Json?                 @map("validation_rules")                 // Min/max length, regex pattern, etc.
  defaultValue      String?               @map("default_value")
  sortOrder         Int                   @default(0) @map("sort_order")
  isActive          Boolean               @default(true) @map("is_active")
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  Event             Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  EventFieldResponse EventFieldResponse[]

  @@index([eventId])
  @@index([sortOrder])
  @@map("event_custom_field")
}

// User responses to custom fields
model EventFieldResponse {
  id                String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  registrationId    String
  fieldId           String              @db.Uuid
  value             String?                                                        // Text value
  fileUrl           String?             @map("file_url")                           // For file uploads
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  EventRegistration EventRegistration   @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  EventCustomField  EventCustomField    @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([registrationId, fieldId])
  @@index([registrationId])
  @@index([fieldId])
  @@map("event_field_response")
}

// Teams for team-based events
model EventTeam {
  id                    String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  eventId               String
  teamId                String                @unique @map("team_id") @db.VarChar(64)    // Human-readable team ID
  name                  String                @db.VarChar(256)
  leaderId              String                @map("leader_id") @db.Uuid
  status                EventTeamStatus       @default(forming)
  lookingForMembers     Boolean               @default(true) @map("looking_for_members")
  isComplete            Boolean               @default(false) @map("is_complete")        // Team has min members
  isLocked              Boolean               @default(false) @map("is_locked")          // Team finalized
  metadata              Json                  @default("{}")
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  Event                 Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  EventTeamMember       EventTeamMember[]
  EventTeamInvitation   EventTeamInvitation[]
  EventTeamRequest      EventTeamRequest[]
  EventRegistration     EventRegistration[]

  @@unique([eventId, name])
  @@index([eventId])
  @@index([leaderId])
  @@index([status])
  @@index([lookingForMembers])
  @@map("event_team")
}

// Team membership
model EventTeamMember {
  id                String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  teamId            String                @db.Uuid
  userId            String                @db.Uuid
  role              EventTeamMemberRole   @default(member)
  status            EventTeamMemberStatus @default(confirmed)
  joinedAt          DateTime              @default(now()) @map("joined_at") @db.Timestamptz(6)
  leftAt            DateTime?             @map("left_at") @db.Timestamptz(6)
  
  EventTeam         EventTeam             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user              UserLogin             @relation("TeamMemberUser", fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@index([status])
  @@map("event_team_member")
}

// Invitations sent by team leader to potential members
model EventTeamInvitation {
  id                String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  teamId            String                    @db.Uuid
  inviterId         String                    @map("inviter_id") @db.Uuid            // Team leader who sent invite
  inviteeId         String                    @map("invitee_id") @db.Uuid            // User being invited
  status            EventInvitationStatus     @default(pending)
  message           String?                   @db.VarChar(500)
  expiresAt         DateTime?                 @map("expires_at") @db.Timestamptz(6)
  respondedAt       DateTime?                 @map("responded_at") @db.Timestamptz(6)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  
  EventTeam         EventTeam                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inviter           UserLogin                 @relation("InvitationInviter", fields: [inviterId], references: [id])
  invitee           UserLogin                 @relation("InvitationInvitee", fields: [inviteeId], references: [id])

  @@unique([teamId, inviteeId])
  @@index([teamId])
  @@index([inviterId])
  @@index([inviteeId])
  @@index([status])
  @@map("event_team_invitation")
}

// Requests sent by users to join teams
model EventTeamRequest {
  id                String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  teamId            String                    @db.Uuid
  requesterId       String                    @map("requester_id") @db.Uuid          // User requesting to join
  status            EventRequestStatus        @default(pending)
  message           String?                   @db.VarChar(500)
  respondedById     String?                   @map("responded_by_id") @db.Uuid       // Team leader who responded
  respondedAt       DateTime?                 @map("responded_at") @db.Timestamptz(6)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  
  EventTeam         EventTeam                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  requester         UserLogin                 @relation("RequestRequester", fields: [requesterId], references: [id])

  @@unique([teamId, requesterId])
  @@index([teamId])
  @@index([requesterId])
  @@index([status])
  @@map("event_team_request")
}

// Event prizes/rewards
model EventPrize {
  id                String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  eventId           String
  position          Int                 @default(1)                                     // 1 = 1st, 2 = 2nd, etc.
  rank              String              @db.VarChar(64)                                 // "Winner", "Runner-up", "Custom"
  title             String              @db.VarChar(128)                                // Display title
  description       String?             @db.VarChar(512)
  prizeType         PrizeType           @default(certificate) @map("prize_type")
  prizeAmount       Float?              @map("prize_amount")                            // For cash prizes
  additionalPerks   Json?               @map("additional_perks")                        // Certificate, internship, etc.
  sortOrder         Int                 @default(0) @map("sort_order")
  isActive          Boolean             @default(true) @map("is_active")
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  Event             Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([sortOrder])
  @@map("event_prize")
}

