// ============================================
// GATE ENTRY MODULE
// ============================================

model GatePass {
  id                    String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  passId                String             @unique @map("pass_id") @db.VarChar(64)
  
  // Visitor Personal Details
  visitorName           String             @map("visitor_name") @db.VarChar(255)
  mobileNumber          String             @map("mobile_number") @db.VarChar(20)
  email                 String?            @db.VarChar(255)
  idProofType           IdProofTypeEnum    @map("id_proof_type")
  idProofNumber         String             @map("id_proof_number") @db.VarChar(100)
  photoFilePath         String?            @map("photo_file_path")
  photo                 String?            @db.VarChar(64)
  gender                GenderEnum?
  age                   Int?
  
  // Visit Details
  purposeOfVisit        VisitPurposeEnum   @map("purpose_of_visit")
  purposeOther          String?            @map("purpose_other") @db.VarChar(255)
  departmentToVisit     String             @map("department_to_visit") @db.VarChar(255)
  personToMeetId        String?            @map("person_to_meet_id") @db.Uuid
  personToMeet          UserLogin?         @relation("GatePassHost", fields: [personToMeetId], references: [id], onDelete: SetNull)
  personToMeetName      String             @map("person_to_meet_name") @db.VarChar(255)
  visitDate             DateTime           @map("visit_date") @db.Date
  expectedEntryTime     String             @map("expected_entry_time") @db.VarChar(10)
  expectedExitTime      String             @map("expected_exit_time") @db.VarChar(10)
  
  // Vehicle Details
  hasVehicle            Boolean            @default(false) @map("has_vehicle")
  vehicleType           VehicleTypeEnum?   @map("vehicle_type")
  vehicleNumber         String?            @map("vehicle_number") @db.VarChar(50)
  vehicleModel          String?            @map("vehicle_model") @db.VarChar(100)
  
  // Additional Information
  numberOfPersons       Int                @default(1) @map("number_of_persons")
  itemsCarrying         String?            @map("items_carrying")
  specialInstructions   String?            @map("special_instructions")
  
  // Pass Status & Tracking
  status                GatePassStatusEnum @default(active)
  qrCode                String?            @map("qr_code")
  
  // Entry/Exit Records
  actualEntryTime       DateTime?          @map("actual_entry_time") @db.Timestamptz(6)
  actualExitTime        DateTime?          @map("actual_exit_time") @db.Timestamptz(6)
  entryGate             String?            @map("entry_gate") @db.VarChar(100)
  exitGate              String?            @map("exit_gate") @db.VarChar(100)
  entryGuardId          String?            @map("entry_guard_id") @db.Uuid
  entryGuard            UserLogin?         @relation("GatePassEntryGuard", fields: [entryGuardId], references: [id], onDelete: SetNull)
  exitGuardId           String?            @map("exit_guard_id") @db.Uuid
  exitGuard             UserLogin?         @relation("GatePassExitGuard", fields: [exitGuardId], references: [id], onDelete: SetNull)
  entryRemarks          String?            @map("entry_remarks")
  exitRemarks           String?            @map("exit_remarks")
  denialReason          String?            @map("denial_reason")
  
  // Metadata
  createdById           String             @map("created_by_id") @db.Uuid
  createdBy             UserLogin          @relation("GatePassCreator", fields: [createdById], references: [id])
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  
  // Relations
  history               GatePassHistory[]
  notifications         GatePassNotification[]
  
  @@index([passId])
  @@index([mobileNumber])
  @@index([visitDate])
  @@index([status])
  @@index([createdById])
  @@map("gate_pass")
}

model GatePassHistory {
  id              String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  gatePassId      String             @map("gate_pass_id") @db.Uuid
  gatePass        GatePass           @relation(fields: [gatePassId], references: [id], onDelete: Cascade)
  
  action          GatePassActionEnum
  performedById   String             @map("performed_by_id") @db.Uuid
  performedBy     UserLogin          @relation("GatePassHistoryPerformer", fields: [performedById], references: [id])
  remarks         String?
  metadata        Json?
  
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  
  @@index([gatePassId])
  @@map("gate_pass_history")
}

model GatePassNotification {
  id              String                      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  gatePassId      String                      @map("gate_pass_id") @db.Uuid
  gatePass        GatePass                    @relation(fields: [gatePassId], references: [id], onDelete: Cascade)
  
  recipientType   NotificationRecipientEnum   @map("recipient_type")
  recipientId     String?                     @map("recipient_id") @db.Uuid
  recipientEmail  String?                     @map("recipient_email") @db.VarChar(255)
  recipientPhone  String?                     @map("recipient_phone") @db.VarChar(20)
  
  notificationType NotificationTypeEnum       @map("notification_type")
  status          NotificationStatusEnum      @default(pending)
  sentAt          DateTime?                   @map("sent_at") @db.Timestamptz(6)
  
  createdAt       DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  
  @@index([gatePassId])
  @@map("gate_pass_notification")
}

