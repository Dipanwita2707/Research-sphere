  @@index([hierarchyDepth])
  @@index([managerId, isActive], map: "reporting_structure_managerId_isActive_idx")
  @@index([userId, isActive], map: "reporting_structure_userId_isActive_idx")
  @@index([isActive])
  @@index([isActive, managerId])
  @@index([isActive, hierarchyDepth])
  @@map("reporting_structure")
}

