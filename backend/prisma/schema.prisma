  correction
  erasure
  grievance
  consent_withdrawal
  nomination

  @@map("data_principal_request_type")
}

enum DataPrincipalRequestStatus {
  submitted
  in_review
  completed
  rejected

  @@map("data_principal_request_status")
}

enum BreachStatus {
  detected
  contained
  board_notified
  principals_notified
  closed

  @@map("breach_status")
}

/// Versioned privacy notice shown to data principals before consent. universityId null = platform default.
model ConsentNotice {
  id            String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  universityId  String?         @map("university_id") @db.Uuid
  university    University?     @relation(fields: [universityId], references: [id], onDelete: Restrict)
  version       String          @db.VarChar(32)
  language      String          @default("en") @db.VarChar(8)
  title         String          @db.VarChar(256)
  content       String          @db.Text
  /// [{ key, label, description, required }]
  purposes      Json            @default("[]")
  isActive      Boolean         @default(true) @map("is_active")
  effectiveFrom DateTime        @default(now()) @map("effective_from") @db.Timestamptz(6)
  createdById   String?         @map("created_by_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  records       ConsentRecord[]

  @@unique([universityId, version, language])
  @@index([universityId, isActive])
  @@map("consent_notices")
}

/// One row per (user, purpose) decision; withdrawal is recorded, never deleted.
model ConsentRecord {
  id                 String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  universityId       String?       @map("university_id") @db.Uuid
  university         University?   @relation(fields: [universityId], references: [id], onDelete: Restrict)
  userId             String        @map("user_id") @db.Uuid
  user               UserLogin     @relation("ConsentRecordUser", fields: [userId], references: [id], onDelete: Restrict)
  noticeId           String        @map("notice_id") @db.Uuid
  notice             ConsentNotice @relation(fields: [noticeId], references: [id], onDelete: Restrict)
  purpose            String        @db.VarChar(64)
  granted            Boolean
  grantedAt          DateTime?     @map("granted_at") @db.Timestamptz(6)
  withdrawnAt        DateTime?     @map("withdrawn_at") @db.Timestamptz(6)
  /// self | guardian
  givenBy            String        @default("self") @map("given_by") @db.VarChar(16)
  guardianName       String?       @map("guardian_name") @db.VarChar(256)
  guardianEmail      String?       @map("guardian_email") @db.VarChar(256)
  guardianRelation   String?       @map("guardian_relation") @db.VarChar(64)
  guardianVerifiedAt DateTime?     @map("guardian_verified_at") @db.Timestamptz(6)
  ipAddress          String?       @map("ip_address") @db.VarChar(64)
  userAgent          String?       @map("user_agent") @db.VarChar(512)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, noticeId, purpose])
  @@index([universityId])
  @@index([userId])
  @@map("consent_records")
}

/// Data principal rights requests (DPDP ss. 11-14) and grievances (s. 13).
model DataPrincipalRequest {
  id           String                     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  universityId String?                    @map("university_id") @db.Uuid
  university   University?                @relation(fields: [universityId], references: [id], onDelete: Restrict)
  userId       String                     @map("user_id") @db.Uuid
  user         UserLogin                  @relation("DataPrincipalRequestUser", fields: [userId], references: [id], onDelete: Restrict)
  type         DataPrincipalRequestType
  status       DataPrincipalRequestStatus @default(submitted)
  description  String?                    @db.Text
  /// For correction requests: { field: newValue }
  details      Json                       @default("{}")
  response     String?                    @db.Text
  dueAt        DateTime                   @map("due_at") @db.Timestamptz(6)
  handledById  String?                    @map("handled_by_id") @db.Uuid
  handledBy    UserLogin?                 @relation("DataPrincipalRequestHandler", fields: [handledById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?                  @map("resolved_at") @db.Timestamptz(6)
  createdAt    DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([universityId, status])
  @@index([userId])
  @@index([dueAt])
  @@map("data_principal_requests")
}

/// Person nominated to exercise the data principal's rights on death/incapacity (DPDP s. 14).
model DataPrincipalNominee {
  id           String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  universityId String?     @map("university_id") @db.Uuid
  university   University? @relation(fields: [universityId], references: [id], onDelete: Restrict)
  userId       String      @unique @map("user_id") @db.Uuid
  user         UserLogin   @relation("DataPrincipalNomineeUser", fields: [userId], references: [id], onDelete: Cascade)
  name         String      @db.VarChar(256)
  email        String?     @db.VarChar(256)
  phone        String?     @db.VarChar(32)
  relation     String?     @db.VarChar(64)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([universityId])
  @@map("data_principal_nominees")
}

/// Personal data breach register. Board intimation is due within 72h of detection (DPDP Rules 2025).
model DataBreachIncident {
  id                   String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  universityId         String?      @map("university_id") @db.Uuid
  university           University?  @relation(fields: [universityId], references: [id], onDelete: Restrict)
  title                String       @db.VarChar(256)
  description          String       @db.Text
  severity             String       @default("medium") @db.VarChar(16)
  status               BreachStatus @default(detected)
  detectedAt           DateTime     @map("detected_at") @db.Timestamptz(6)
  boardReportDueAt     DateTime     @map("board_report_due_at") @db.Timestamptz(6)
  boardNotifiedAt      DateTime?    @map("board_notified_at") @db.Timestamptz(6)
  principalsNotifiedAt DateTime?    @map("principals_notified_at") @db.Timestamptz(6)
  affectedCount        Int?         @map("affected_count")
  dataCategories       Json         @default("[]") @map("data_categories")
  remediation          String?      @db.Text
  reportedById         String?      @map("reported_by_id") @db.Uuid
  reportedBy           UserLogin?   @relation("DataBreachReporter", fields: [reportedById], references: [id], onDelete: SetNull)
