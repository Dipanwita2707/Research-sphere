// =====================================
// Bug Report System
// =====================================

enum ResolutionStatus {
  resolved
  unresolved
}

model BugReport {
  id               String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId           String              @map("user_id") @db.Uuid
  universityId     String?             @map("university_id") @db.Uuid
  userRole         String              @map("user_role") @db.VarChar(32)
  userIdentifier   String              @map("user_identifier") @db.VarChar(64)
  userEmail        String?             @map("user_email") @db.VarChar(255)
  description      String              @db.Text
  pageUrl          String              @map("page_url") @db.VarChar(2048)
  routePath        String              @map("route_path") @db.VarChar(512)
  resolutionStatus ResolutionStatus    @default(unresolved) @map("resolution_status")
  resolvedAt       DateTime?           @map("resolved_at") @db.Timestamptz(6)
  resolvedBy       String?             @map("resolved_by") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user             UserLogin           @relation("BugReportUser", fields: [userId], references: [id], onDelete: Cascade)
  resolver         UserLogin?          @relation("BugReportResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)
  university       University?         @relation(fields: [universityId], references: [id])
  screenshots      BugReportScreenshot[]

  @@index([userId])
  @@index([createdAt])
  @@index([resolutionStatus])
  @@index([resolvedBy])
  @@index([universityId])
  @@map("bug_reports")
}

model BugReportScreenshot {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  bugReportId        String    @map("bug_report_id") @db.Uuid
  originalFilename   String    @map("original_filename") @db.VarChar(255)
  storedFilename     String    @map("stored_filename") @db.VarChar(255)
  fileSize           Int       @map("file_size")
  mimeType           String    @map("mime_type") @db.VarChar(64)
  storagePath        String    @map("storage_path") @db.VarChar(512)
  thumbnailFilename  String?   @map("thumbnail_filename") @db.VarChar(255)
  thumbnailPath      String?   @map("thumbnail_path") @db.VarChar(512)
  uploadedAt         DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  bugReport          BugReport @relation(fields: [bugReportId], references: [id], onDelete: Cascade)

  @@index([bugReportId])
  @@map("bug_report_screenshots")
}

// =====================================
// Software License Protection
// =====================================

/// Hardware-bound license record with explicit admin approval control.
/// Each license key is issued by the developer and requires explicit approval
/// or hardware binding. Set isActive = false to revoke access instantly.
model License {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  licenseKey         String    @unique @map("license_key") @db.VarChar(128)
  assignedTo         String    @map("assigned_to") @db.VarChar(256)
  hardwareId         String?   @map("hardware_id") @db.VarChar(128)
  allowedHardwareIds String[]  @default([]) @map("allowed_hardware_ids")
  pendingHardwareId  String?   @map("pending_hardware_id") @db.VarChar(128)
  requiresApproval   Boolean   @default(true) @map("requires_approval")
  isActive           Boolean   @default(true) @map("is_active")
  notes              String?   @db.Text
  activatedAt        DateTime? @map("activated_at") @db.Timestamptz(6)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([licenseKey])
  @@index([isActive])
  @@map("licenses")
}