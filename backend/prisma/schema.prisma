  updatedBy                       UserLogin?             @relation("ResearchPolicyUpdatedBy", fields: [updatedById], references: [id], map: "research_incentive_policy_updated_by_fkey")
  university                      University             @relation(fields: [universityId], references: [id], onDelete: Cascade)

  // isActive = enabled by an admin; the policy applying to a date is the enabled one whose
  // effective window covers it. No two enabled policies of a university + type overlap:
  // exclusion constraint research_incentive_policy_no_overlap (book, book chapter, conference,
  // grant and IPR policies have the same *_no_overlap constraint) — migration
  // 20261002233000_incentive_policy_windows; Prisma cannot model it.
  @@index([publicationType])
  @@index([isActive])
  @@index([universityId])
  @@map("research_incentive_policy")
}

