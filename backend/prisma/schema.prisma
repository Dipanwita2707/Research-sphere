model ResearchProfileIdentity {
  id                    String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  universityId          String                 @map("university_id") @db.Uuid
  university            University             @relation("ResearchProfileIdentityUniversity", fields: [universityId], references: [id], onDelete: Restrict)
  userId                String                 @unique @map("user_id") @db.Uuid
  orcid                 String?                @db.VarChar(32)
  scopusAuthorId        String?                @map("scopus_author_id") @db.VarChar(64)
  pubmedId              String?                @map("pubmed_id") @db.VarChar(64)
  webOfScienceId        String?                @map("web_of_science_id") @db.VarChar(64)
  affiliationAliases    Json?                  @default("[]") @map("affiliation_aliases")
  autoSyncEnabled       Boolean                @default(true) @map("auto_sync_enabled")
  filterSgtOnly         Boolean                @default(false) @map("filter_sgt_only")
  syncFrequencyDays     Int                    @default(1) @map("sync_frequency_days")
  syncStatus            String                 @default("never_synced") @map("sync_status") @db.VarChar(32)
  syncError             String?                @map("sync_error")
  lastSyncedAt          DateTime?              @map("last_synced_at") @db.Timestamptz(6)
  /// When the scheduled sync should next pick this profile up. Set to lastSyncedAt +
  /// syncFrequencyDays after a clean run, and a few hours ahead after a source failed.
  nextSyncAt            DateTime?              @map("next_sync_at") @db.Timestamptz(6)
  /// OpenAlex author id(s) resolved from the ORCID / Scopus id (never from the name alone).
  openAlexAuthorId      String?                @map("openalex_author_id") @db.VarChar(256)
  /// Outcome of checking the ORCID / Scopus id against the registries:
  /// { orcid?: { status: 'verified'|'unverified', name?, reason?, checkedAt }, scopus?: {...} }
  identityVerification  Json?                  @map("identity_verification")
  // Author profile content + privacy. 'public' = anyone with the link (no login),
  // 'institution' = signed-in members of the same university, 'private' = owner + admins.
  bio                   String?                @db.Text
  researchInterests     String[]               @default([]) @map("research_interests")
  /// Research CV sections the author fills in: googleScholarUrl, education[], experience[], teaching[], skills[],
  /// memberships[], awards[], presentations[], references[] (references are printed only on the author's own CV).
  cvDetails             Json                   @default("{}") @map("cv_details")
  profileVisibility     String                 @default("institution") @map("profile_visibility") @db.VarChar(16)
  showEmail             Boolean                @default(false) @map("show_email")
  showPhone             Boolean                @default(false) @map("show_phone")
  showResearchInterests Boolean                @default(true) @map("show_research_interests")
  showPublications      Boolean                @default(true) @map("show_publications")
  showCoAuthors         Boolean                @default(true) @map("show_co_authors")
  showMetrics           Boolean                @default(true) @map("show_metrics")
  showPhoto             Boolean                @default(true) @map("show_photo")
  allowSearchIndexing   Boolean                @default(false) @map("allow_search_indexing")
  /// URL handle for the public page: /p/<university-slug>/<publicHandle>
  publicHandle          String?                @map("public_handle") @db.VarChar(80)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user                  UserLogin              @relation("UserResearchProfileIdentity", fields: [userId], references: [id], onDelete: Cascade)
  importRuns            PublicationImportRun[]
  publicationImports    PublicationImport[]

  @@unique([universityId, publicHandle])
  @@index([autoSyncEnabled, nextSyncAt])
  @@index([orcid])
  @@index([scopusAuthorId])
  @@index([pubmedId])
  @@index([autoSyncEnabled, lastSyncedAt])
  @@index([universityId])
  @@map("research_profile_identity")
}

