// ============================================================================
// Incentive payouts (finance)
// One payable line per eligible author per approved work. Finance reviewer
// recommends (verifies) a line, a DIFFERENT finance approver approves the batch,
// then the batch is marked paid with the payroll/bank reference. No bank details
// are stored — payment goes through payroll by employee ID.
// ============================================================================

enum IncentiveSourceType {
  research_contribution
  grant
  ipr

  @@map("incentive_source_type_enum")
}

enum IncentivePayoutStatus {
  pending_verification
  recommended
  on_hold
  approved
  paid
  cancelled

  @@map("incentive_payout_status_enum")
}

enum PayoutBatchStatus {
  draft
  approved
  paid
  cancelled

  @@map("payout_batch_status_enum")
}

model IncentivePayout {
  id                     String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  universityId           String                 @map("university_id") @db.Uuid
  university             University             @relation("IncentivePayoutUniversity", fields: [universityId], references: [id], onDelete: Restrict)
  sourceType             IncentiveSourceType    @map("source_type")
  sourceId               String                 @map("source_id") @db.Uuid
  researchContributionId String?                @map("research_contribution_id") @db.Uuid
  researchContribution   ResearchContribution?  @relation(fields: [researchContributionId], references: [id], onDelete: Restrict)
  /// research_paper | book | book_chapter | conference_paper | grant | patent | copyright | ...
  workType               String                 @map("work_type") @db.VarChar(32)
  title                  String                 @db.VarChar(512)
  referenceNumber        String?                @map("reference_number") @db.VarChar(100)
  /// Same as the contribution's workKey; cleared when a line is cancelled so the work can be re-claimed.
  workKey                String?                @map("work_key") @db.VarChar(320)
  payeeUserId            String                 @map("payee_user_id") @db.Uuid
  payee                  UserLogin              @relation("PayoutPayee", fields: [payeeUserId], references: [id], onDelete: Restrict)
  payeeName              String                 @map("payee_name") @db.VarChar(256)
  payeeEmployeeId        String?                @map("payee_employee_id") @db.VarChar(64)
  payeeRole              String?                @map("payee_role") @db.VarChar(64)
  /// Payee's school and department when the line was created (budget attribution). Null = unassigned.
  schoolId               String?                @map("school_id") @db.Uuid
  school                 FacultySchoolList?     @relation("PayoutSchool", fields: [schoolId], references: [id], onDelete: SetNull)
  departmentId           String?                @map("department_id") @db.Uuid
  department             Department?            @relation("PayoutDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  calculatedAmount       Decimal                @map("calculated_amount") @db.Decimal(15, 2)
  approvedAmount         Decimal                @map("approved_amount") @db.Decimal(15, 2)
  points                 Int                    @default(0)
  adjustmentReason       String?                @map("adjustment_reason")
  status                 IncentivePayoutStatus  @default(pending_verification)
  holdReason             String?                @map("hold_reason")
  /// Indian financial year of DRD approval, e.g. "2026-27" (payment batches and reports).
  financialYear          String                 @map("financial_year") @db.VarChar(9)
  /// Incentive cycle whose budget this line consumes: the cycle containing the date that selected
  /// the incentive policy (publication / sanction / IPR publication date). Null = no cycle covers it.
  cycleId                String?                @map("cycle_id") @db.Uuid
  cycle                  IncentiveCycle?        @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  /// The date that selected the incentive policy (and so the cycle), as a calendar day.
  policyDate             DateTime?              @map("policy_date") @db.Date
  sourceApprovedAt       DateTime               @map("source_approved_at") @db.Timestamptz(6)
  recommendedById        String?                @map("recommended_by_id") @db.Uuid
  recommendedBy          UserLogin?             @relation("PayoutRecommendedBy", fields: [recommendedById], references: [id], onDelete: Restrict)
  recommendedAt          DateTime?              @map("recommended_at") @db.Timestamptz(6)
  batchId                String?                @map("batch_id") @db.Uuid
  batch                  PayoutBatch?           @relation(fields: [batchId], references: [id], onDelete: Restrict)
  tdsAmount              Decimal?               @map("tds_amount") @db.Decimal(15, 2)
  paymentReference       String?                @map("payment_reference") @db.VarChar(64)
  paidAt                 DateTime?              @map("paid_at") @db.Timestamptz(6)
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  events                 IncentivePayoutEvent[]

  @@unique([universityId, sourceType, sourceId, payeeUserId])
  @@unique([universityId, workKey, payeeUserId])
  @@index([universityId])
  @@index([universityId, status])
  @@index([universityId, financialYear])
  @@index([payeeUserId])
  @@index([batchId])
  @@index([researchContributionId])
  @@index([universityId, financialYear, schoolId])
  @@index([cycleId, schoolId])
  @@index([departmentId])
  @@map("incentive_payout")
}

model PayoutBatch {
  id               String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  universityId     String                 @map("university_id") @db.Uuid
  university       University             @relation("PayoutBatchUniversity", fields: [universityId], references: [id], onDelete: Restrict)
  batchNumber      String                 @map("batch_number") @db.VarChar(32)
  title            String?                @db.VarChar(256)
  financialYear    String                 @map("financial_year") @db.VarChar(9)
  status           PayoutBatchStatus      @default(draft)
  totalAmount      Decimal                @default(0) @map("total_amount") @db.Decimal(15, 2)
  lineCount        Int                    @default(0) @map("line_count")
  createdById      String                 @map("created_by_id") @db.Uuid
  createdBy        UserLogin              @relation("PayoutBatchCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById     String?                @map("approved_by_id") @db.Uuid
  approvedBy       UserLogin?             @relation("PayoutBatchApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  approvedAt       DateTime?              @map("approved_at") @db.Timestamptz(6)
  approvalComments String?                @map("approval_comments")
  /// Approved by someone who prepared it or recommended its lines (allowed only with FinanceSettings.allowSelfApproval; the reason is in the batch events).
  selfApproved     Boolean                @default(false) @map("self_approved")
  paidById         String?                @map("paid_by_id") @db.Uuid
  paidBy           UserLogin?             @relation("PayoutBatchPaidBy", fields: [paidById], references: [id], onDelete: Restrict)
  paidAt           DateTime?              @map("paid_at") @db.Timestamptz(6)
  paymentDate      DateTime?              @map("payment_date") @db.Date
  paymentReference String?                @map("payment_reference") @db.VarChar(64)
  cancelledReason  String?                @map("cancelled_reason")
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  payouts          IncentivePayout[]
  events           IncentivePayoutEvent[]

  @@unique([universityId, batchNumber])
  @@index([universityId])
  @@index([universityId, status])
  @@map("payout_batch")
}

/// Append-only trail of every finance action on a payout line or batch.
model IncentivePayoutEvent {
  id           String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  universityId String           @map("university_id") @db.Uuid
  university   University       @relation("IncentivePayoutEventUniversity", fields: [universityId], references: [id], onDelete: Restrict)
  payoutId     String?          @map("payout_id") @db.Uuid
  payout       IncentivePayout? @relation(fields: [payoutId], references: [id], onDelete: Restrict)
  batchId      String?          @map("batch_id") @db.Uuid
  batch        PayoutBatch?     @relation(fields: [batchId], references: [id], onDelete: Restrict)
  action       String           @db.VarChar(48)
  fromStatus   String?          @map("from_status") @db.VarChar(32)
  toStatus     String?          @map("to_status") @db.VarChar(32)
  amount       Decimal?         @db.Decimal(15, 2)
  comments     String?
  actorId      String           @map("actor_id") @db.Uuid
  actor        UserLogin        @relation("PayoutEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([universityId])
  @@index([payoutId])
  @@index([batchId])
  @@map("incentive_payout_event")
}

/// Grant money actually received, per instalment (NAAC 3.1 / NIRF need it per financial year).
model GrantFundReceipt {
  id                 String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  universityId       String           @map("university_id") @db.Uuid
  university         University       @relation("GrantFundReceiptUniversity", fields: [universityId], references: [id], onDelete: Restrict)
  grantApplicationId String           @map("grant_application_id") @db.Uuid
  grantApplication   GrantApplication @relation(fields: [grantApplicationId], references: [id], onDelete: Restrict)
  amount             Decimal          @db.Decimal(15, 2)
  receivedDate       DateTime         @map("received_date") @db.Date
  financialYear      String           @map("financial_year") @db.VarChar(9)
  reference          String?          @db.VarChar(128)
  notes              String?
  recordedById       String           @map("recorded_by_id") @db.Uuid
  recordedBy         UserLogin        @relation("GrantReceiptRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([universityId])
  @@index([grantApplicationId])
  @@index([universityId, financialYear])
  @@map("grant_fund_receipt")
}

// ─── Research budget allocation (finance) ───────────────────────────────────
// One budget per university per incentive cycle. Allocations form the tree
// university (the budget total) → school → department. Spending is read from the payout
// ledger (IncentivePayout.schoolId / departmentId); nothing here is a payment.

enum BudgetNodeType {
  university
  school
  department

  @@map("budget_node_type_enum")
}

/// Per-university finance rules. One row per university, created on first change; no row = defaults.
model FinanceSettings {
  id                String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  universityId      String     @unique @map("university_id") @db.Uuid
  university        University @relation("FinanceSettingsUniversity", fields: [universityId], references: [id], onDelete: Cascade)
  /// Small teams: whoever prepared a payment batch or recommended its lines may also approve it,
  /// giving a reason each time. Off = a second person must approve (separation of duties).
  allowSelfApproval Boolean    @default(false) @map("allow_self_approval")
  updatedById       String?    @map("updated_by_id") @db.Uuid
  updatedBy         UserLogin? @relation("FinanceSettingsUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("finance_settings")
}

/// An incentive cycle: the period that incentive policies and the research budget share
/// (by default the Indian financial year, April–March). Cycles of a university never overlap
/// (exclusion constraint), and an enabled policy saved while cycles exist must sit inside one.
model IncentiveCycle {
  id           String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  universityId String                  @map("university_id") @db.Uuid
  university   University              @relation("IncentiveCycleUniversity", fields: [universityId], references: [id], onDelete: Restrict)
  /// e.g. "FY 2026-27"
  name         String                  @db.VarChar(64)
  startDate    DateTime                @map("start_date") @db.Date
  endDate      DateTime                @map("end_date") @db.Date
  notes        String?
  /// Null for cycles created by a migration.
  createdById  String?                 @map("created_by_id") @db.Uuid
  createdBy    UserLogin?              @relation("IncentiveCycleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById  String?                 @map("updated_by_id") @db.Uuid
  updatedBy    UserLogin?              @relation("IncentiveCycleUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  budget       ResearchBudget?
  allocations  BudgetAllocation[]
  events       BudgetAllocationEvent[]
  payouts      IncentivePayout[]

  @@unique([universityId, name])
  @@index([universityId, startDate])
  @@map("incentive_cycle")
}

model ResearchBudget {
  id                  String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  universityId        String                  @map("university_id") @db.Uuid
  university          University              @relation("ResearchBudgetUniversity", fields: [universityId], references: [id], onDelete: Restrict)
  cycleId             String                  @unique @map("cycle_id") @db.Uuid
  cycle               IncentiveCycle          @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  totalAmount         Decimal                 @default(0) @map("total_amount") @db.Decimal(15, 2)
  /// University-level split by category: { research_paper, book, book_chapter, conference_paper, ipr, grant } → amount.
  categoryAllocations Json                    @default("{}") @map("category_allocations")
  notes               String?
  /// When true, approving a payment batch that leaves a node over its allocation is refused (409 BUDGET_EXCEEDED).
  enforceLimit        Boolean                 @default(false) @map("enforce_limit")
  /// Utilisation % at which a node is flagged "near limit".
  warnThresholdPct    Int                     @default(80) @map("warn_threshold_pct")
  /// Bumped on every allocation write; the row lock serialises concurrent writers on this budget.
  version             Int                     @default(0)
  createdById         String                  @map("created_by_id") @db.Uuid
  createdBy           UserLogin               @relation("ResearchBudgetCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById         String?                 @map("updated_by_id") @db.Uuid
  updatedBy           UserLogin?              @relation("ResearchBudgetUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  allocations         BudgetAllocation[]
  events              BudgetAllocationEvent[]

  @@index([universityId])
  @@map("research_budget")
}

model BudgetAllocation {
  id                  String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  universityId        String             @map("university_id") @db.Uuid
  university          University         @relation("BudgetAllocationUniversity", fields: [universityId], references: [id], onDelete: Restrict)
  budgetId            String             @map("budget_id") @db.Uuid
  budget              ResearchBudget     @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  cycleId             String             @map("cycle_id") @db.Uuid
  cycle               IncentiveCycle     @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  /// school or department (the university node is the budget itself).
  nodeType            BudgetNodeType     @map("node_type")
  /// The school id or department id; the matching schoolId / departmentId column carries the FK.
  nodeId              String             @map("node_id") @db.Uuid
  schoolId            String?            @map("school_id") @db.Uuid
  school              FacultySchoolList? @relation("BudgetAllocationSchool", fields: [schoolId], references: [id], onDelete: Cascade)
  departmentId        String?            @map("department_id") @db.Uuid
  department          Department?        @relation("BudgetAllocationDepartment", fields: [departmentId], references: [id], onDelete: Cascade)
  amount              Decimal            @default(0) @db.Decimal(15, 2)
  /// Optional split by category (same keys as ResearchBudget.categoryAllocations); sum ≤ amount.
  categoryAllocations Json               @default("{}") @map("category_allocations")
  updatedById         String?            @map("updated_by_id") @db.Uuid
  updatedBy           UserLogin?         @relation("BudgetAllocationUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([universityId, cycleId, nodeType, nodeId])
  @@index([universityId])
  @@index([budgetId])
  @@map("budget_allocation")
}

/// Append-only trail: budget and allocation changes (old → new, reason) and over-budget warnings/blocks.
model BudgetAllocationEvent {
  id            String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  universityId  String         @map("university_id") @db.Uuid
  university    University     @relation("BudgetAllocationEventUniversity", fields: [universityId], references: [id], onDelete: Restrict)
  budgetId      String         @map("budget_id") @db.Uuid
  budget        ResearchBudget @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  cycleId       String         @map("cycle_id") @db.Uuid
  cycle         IncentiveCycle @relation(fields: [cycleId], references: [id], onDelete: Restrict)
  nodeType      BudgetNodeType @map("node_type")
  nodeId        String         @map("node_id") @db.Uuid
  /// Node name when the event was written (a school/department may be renamed or removed later).
  nodeName      String?        @map("node_name") @db.VarChar(256)
  /// budget_created | budget_updated | allocation_created | allocation_updated | over_budget_warning | over_budget_blocked
  action        String         @db.VarChar(48)
  oldAmount     Decimal?       @map("old_amount") @db.Decimal(15, 2)
  newAmount     Decimal?       @map("new_amount") @db.Decimal(15, 2)
  oldCategories Json?          @map("old_categories")
  newCategories Json?          @map("new_categories")
  details       Json?
  reason        String?
  actorId       String         @map("actor_id") @db.Uuid
  actor         UserLogin      @relation("BudgetAllocationEventActor", fields: [actorId], references: [id], onDelete: Restrict)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([universityId, cycleId])
  @@index([budgetId])
  @@index([universityId, nodeType, nodeId])
  @@map("budget_allocation_event")
}
