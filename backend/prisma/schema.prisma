  quartile                   quartile_enum?
  sdg_goals                  String[]
  naasRating                 Decimal?                              @map("naas_rating") @db.Decimal(4, 2)
  subsidiaryImpactFactor     Decimal?                              @map("subsidiary_impact_factor") @db.Decimal(10, 4)
