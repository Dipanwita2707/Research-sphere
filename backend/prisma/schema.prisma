// ===========================================
// TMS (Ticket Management System) Models
// ===========================================

model TmsMasterCategory {
  id          String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name        String        @db.VarChar(256)
  description String?       @db.VarChar(512)
  sortOrder   Int           @default(0) @map("sort_order")
  isActive    Boolean       @default(true) @map("is_active")
  isAcademic  Boolean       @default(false) @map("is_academic")
  employeeId  String?       @map("employee_id") @db.Uuid
  employee    UserLogin?    @relation("TmsMasterCategoryEmployee", fields: [employeeId], references: [id])
  categories  TmsCategory[]
  tickets     TmsTicket[]   @relation("TmsTicketMasterCategory")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tms_master_category")
}

model TmsCategory {
  id               String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name             String            @db.VarChar(256)
  description      String?           @db.VarChar(512)
  sortOrder        Int               @default(0) @map("sort_order")
  isActive         Boolean           @default(true) @map("is_active")
  masterCategoryId String            @map("master_category_id") @db.Uuid
  masterCategory   TmsMasterCategory @relation(fields: [masterCategoryId], references: [id], onDelete: Cascade)
  employeeId       String?           @map("employee_id") @db.Uuid
  employee         UserLogin?        @relation("TmsCategoryEmployee", fields: [employeeId], references: [id])
  subCategories    TmsSubCategory[]
  tickets          TmsTicket[]       @relation("TmsTicketCategory")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tms_category")
}

model TmsSubCategory {
  id           String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name         String           @db.VarChar(256)
  description  String?          @db.VarChar(512)
  sortOrder    Int              @default(0) @map("sort_order")
  isActive     Boolean          @default(true) @map("is_active")
  categoryId   String           @map("category_id") @db.Uuid
  category     TmsCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  employeeId   String?          @map("employee_id") @db.Uuid
  employee     UserLogin?       @relation("TmsSubCategoryEmployee", fields: [employeeId], references: [id])
  priority     TmsPriorityEnum  @default(medium)
  slaHours     Int              @default(48) @map("sla_hours")
  tickets      TmsTicket[]      @relation("TmsTicketSubCategory")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("tms_sub_category")
}

model TmsTicket {
  id                String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  requestId         String            @unique @map("request_id") @db.VarChar(32)
  messageType       TmsMessageTypeEnum @map("message_type")
  subject           String            @db.VarChar(256)
  masterCategoryId  String            @map("master_category_id") @db.Uuid
  masterCategory    TmsMasterCategory @relation("TmsTicketMasterCategory", fields: [masterCategoryId], references: [id])
  categoryId        String            @map("category_id") @db.Uuid
  category          TmsCategory       @relation("TmsTicketCategory", fields: [categoryId], references: [id])
  subCategoryId     String            @map("sub_category_id") @db.Uuid
  subCategory       TmsSubCategory    @relation("TmsTicketSubCategory", fields: [subCategoryId], references: [id])
  contactNumber     String            @map("contact_number") @db.VarChar(20)
  description       String
  documentPath      String?           @map("document_path")
  documentName      String?           @map("document_name") @db.VarChar(256)
  priority          TmsPriorityEnum   @default(medium)
  status            TmsTicketStatusEnum @default(open)
  currentLevel      TmsEscalationLevelEnum @default(sub_category) @map("current_level")
  createdById       String            @map("created_by_id") @db.Uuid
  createdBy         UserLogin         @relation("TmsTicketCreatedBy", fields: [createdById], references: [id])
  assignedToId      String?           @map("assigned_to_id") @db.Uuid
  assignedTo        UserLogin?        @relation("TmsTicketAssignedTo", fields: [assignedToId], references: [id])
  resolvedAt        DateTime?         @map("resolved_at") @db.Timestamptz(6)
  closedAt          DateTime?         @map("closed_at") @db.Timestamptz(6)
  lastEscalatedAt   DateTime?         @map("last_escalated_at") @db.Timestamptz(6)
  escalationDeadline DateTime?        @map("escalation_deadline") @db.Timestamptz(6)
  closureRemarks    String?           @map("closure_remarks")
  timeline          TmsTimeline[]
  rating            TmsRating?
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([requestId])
  @@index([status])
  @@index([createdById])
  @@index([assignedToId])
  @@index([currentLevel])
  @@index([escalationDeadline])
  @@index([createdAt])
  @@map("tms_ticket")
}

model TmsTimeline {
  id            String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ticketId      String              @map("ticket_id") @db.Uuid
  ticket        TmsTicket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  action        TmsTimelineActionEnum
  fromLevel     TmsEscalationLevelEnum? @map("from_level")
  toLevel       TmsEscalationLevelEnum? @map("to_level")
  remarks       String?
  performedById String?             @map("performed_by_id") @db.Uuid
  performedBy   UserLogin?          @relation("TmsTimelinePerformedBy", fields: [performedById], references: [id])
  isAutomatic   Boolean             @default(false) @map("is_automatic")
  metadata      Json                @default("{}")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([ticketId])
  @@index([createdAt])
  @@map("tms_timeline")
}

model TmsRating {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ticketId  String    @unique @map("ticket_id") @db.Uuid
  ticket    TmsTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  rating    Int       @db.SmallInt
  feedback  String?
  ratedById String    @map("rated_by_id") @db.Uuid
  ratedBy   UserLogin @relation("TmsRatingByUser", fields: [ratedById], references: [id])
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("tms_rating")
}

// Stores the employee assigned to handle tickets at Registrar / Dean / VC levels
model TmsRoleHandler {
  id         String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  role       TmsEscalationLevelEnum
  employeeId String               @map("employee_id") @db.Uuid
  employee   UserLogin            @relation("TmsRoleHandlerEmployee", fields: [employeeId], references: [id])
  isActive   Boolean              @default(true) @map("is_active")
  createdAt  DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([role])
  @@map("tms_role_handler")
}

enum TmsMessageTypeEnum {
  grievance
  assistance
  enquiry
  feedback

  @@map("tms_message_type_enum")
}

enum TmsPriorityEnum {
  low
  medium
  high
  urgent

  @@map("tms_priority_enum")
}

enum TmsTicketStatusEnum {
