  lookingForTeammatesEnabled Boolean             @default(true)            // Enable "Looking for Teammates" feature
  
  // Team Settings (additional)
  allowCrossInstituteTeams   Boolean             @default(false)           // Allow teams from different institutes
  allowTeamEditAfterSubmission Boolean           @default(false)           // Allow team editing after submission
  autoApproveTeams           Boolean             @default(true)            // Auto-approve teams
  
  // Registration Control Settings
  registrationCap            Int?                                          // Overall registration limit
  showParticipantsPublicly   Boolean             @default(false)           // Show participants publicly
  allowWithdrawRegistration  Boolean             @default(true)            // Allow withdraw registration
  lockTeamAfterDeadline      Boolean             @default(true)            // Lock team after deadline
  
  // Team Discovery Settings
  allowPublicTeamListing     Boolean             @default(true)            // Allow public team listing
  allowJoinRequests          Boolean             @default(true)            // Allow join requests
  allowInviteSystem          Boolean             @default(true)            // Allow invite system
  
  // Prize Settings
  prizesEnabled              Boolean             @default(false)           // Enable prize section
  
  // Metadata
  createdById                String              @db.Uuid
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime
  
  // Relations
  user_login                 UserLogin           @relation(fields: [createdById], references: [id])
  note                       Note                @relation(fields: [notingId], references: [id])
  EventEntry                 EventEntry[]
  EventRegistration          EventRegistration[]
  EventVolunteer             EventVolunteer[]
  EventCustomField           EventCustomField[]
  EventTeam                  EventTeam[]
  EventPrize                 EventPrize[]

  @@index([createdById])
  @@index([eventId])
  @@index([eventType])
  @@index([notingId])
  @@index([startDate])
  @@index([status])
  @@index([status, startDate], map: "event_status_startDate_idx")
  @@index([opportunityMode])
  @@index([participationType])
}

model EventEntry {
