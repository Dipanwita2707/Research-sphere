generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "relationJoins"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext, uuid_ossp(map: "uuid-ossp"), btree_gist]
}

// =====================================
// SaaS Multi-Tenancy Models
// =====================================

model University {
  id                              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code                            String    @unique @db.VarChar(32)
  name                            String    @db.VarChar(256)
  slug                            String    @unique @db.VarChar(64)
  // ── Branding & theme (see backend/src/modules/branding) ──────────────────
  // logoUrl now holds the storage key of the uploaded light logo (S3 key or local
  // uploads path, written only by the branding service after re-encoding the image);
  // browsers fetch it through GET /public/branding/:slug/logo/light, never directly.
  logoUrl                         String?   @map("logo_url") @db.VarChar(512)
  // Optional custom primary colour (#RRGGBB) layered over the theme preset.
  primaryColor                    String?   @map("primary_color") @db.VarChar(16)
  displayName                     String?   @map("display_name") @db.VarChar(256)
  shortName                       String?   @map("short_name") @db.VarChar(32)
  tagline                         String?   @db.VarChar(160)
  logoDarkKey                     String?   @map("logo_dark_key") @db.VarChar(512)
  faviconKey                      String?   @map("favicon_key") @db.VarChar(512)
  /// Storage key of the banner illustration on research profile / My Work pages (null = built-in art)
  heroImageKey                    String?   @map("hero_image_key") @db.VarChar(512)
  themePreset                     String    @default("classic-wine") @map("theme_preset") @db.VarChar(32)
  accentColor                     String?   @map("accent_color") @db.VarChar(16)
  heroHeading                     String?   @map("hero_heading") @db.VarChar(120)
  heroSubheading                  String?   @map("hero_subheading") @db.VarChar(280)
  brandingUpdatedAt               DateTime? @map("branding_updated_at") @db.Timestamptz(6)
  contactEmail                    String?   @map("contact_email") @db.VarChar(256)
  websiteUrl                      String?   @map("website_url") @db.VarChar(512)
  address                         String?   @db.Text
  city                            String?   @db.VarChar(128)
  state                           String?   @db.VarChar(128)
  country                         String?   @default("India") @db.VarChar(64)
  timezone                        String?   @default("Asia/Kolkata") @db.VarChar(64)
  isActive                        Boolean   @default(true) @map("is_active")
  trialEndsAt                     DateTime? @map("trial_ends_at") @db.Timestamptz(6)
  // Admin-curated extra affiliation name variants (aliases) that the
  // affiliation engine can't derive algorithmically (e.g. alternate
  // transliterations, historical names). Union'd with the auto-generated
  // variant list — see backend/src/shared/utils/affiliationEngine.js.
  affiliationAliases              Json?     @default("[]") @map("affiliation_aliases")
  // Elsevier Scopus affiliation ids (AF-ID) of this university. Opaque numbers that
  // cannot be derived from the name; used to recognise home-institution authors on
  // Scopus records and to constrain "my university only" Scopus searches.
  scopusAffiliationIds            String[]  @default([]) @map("scopus_affiliation_ids")
  // DPDP: Data Protection Officer / grievance officer published to data principals
  dpoName                         String?   @map("dpo_name") @db.VarChar(256)
  dpoEmail                        String?   @map("dpo_email") @db.VarChar(256)
  dpoPhone                        String?   @map("dpo_phone") @db.VarChar(32)
  requireGuardianConsentForMinors Boolean   @default(true) @map("require_guardian_consent_for_minors")
  createdAt                       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  users                                 UserLogin[]
  schools                               FacultySchoolList[]
  centralDepts                          CentralDepartment[]
  roles                                 Role[]
  notifications                         Notification[]
  auditLogs                             AuditLog[]
  subscription                          UniversitySubscription?
  apiUsageDaily                         ApiUsageDaily[]
  bugReports                            BugReport[]
  incentivePolicies                     IncentivePolicy[]
  researchIncentivePolicies             ResearchIncentivePolicy[]
  bookIncentivePolicies                 BookIncentivePolicy[]
  bookChapterIncentivePolicies          BookChapterIncentivePolicy[]
  conferenceIncentivePolicies           ConferenceIncentivePolicy[]
  grantIncentivePolicies                GrantIncentivePolicy[]
  iprApplications                       IprApplication[]                       @relation("IprApplicationUniversity")
  iprStatusHistorys                     IprStatusHistory[]                     @relation("IprStatusHistoryUniversity")
  iprReviews                            IprReview[]                            @relation("IprReviewUniversity")
  iprEditSuggestions                    IprEditSuggestion[]                    @relation("IprEditSuggestionUniversity")
  iprContributors                       IprContributor[]                       @relation("IprContributorUniversity")
  iprFinances                           IprFinance[]                           @relation("IprFinanceUniversity")
  iprApplicantDetailss                  IprApplicantDetails[]                  @relation("IprApplicantDetailsUniversity")
  iprSdgs                               IprSdg[]                               @relation("IprSdgUniversity")
  iprStatusUpdates                      IprStatusUpdate[]                      @relation("IprStatusUpdateUniversity")
  iprCollaborativeSessions              IprCollaborativeSession[]              @relation("IprCollaborativeSessionUniversity")
  iPRs                                  IPR[]                                  @relation("IPRUniversity")
  researchContributions                 ResearchContribution[]                 @relation("ResearchContributionUniversity")
  researchContributionReviews           ResearchContributionReview[]           @relation("ResearchContributionReviewUniversity")
  researchContributionAuthors           ResearchContributionAuthor[]           @relation("ResearchContributionAuthorUniversity")
  researchContributionStatusHistorys    ResearchContributionStatusHistory[]    @relation("ResearchContributionStatusHistoryUniversity")
  researchContributionEditSuggestions   ResearchContributionEditSuggestion[]   @relation("ResearchContributionEditSuggestionUniversity")
  researchContributionApplicantDetailss ResearchContributionApplicantDetails[] @relation("ResearchContributionApplicantDetailsUniversity")
  researchProgressTrackers              ResearchProgressTracker[]              @relation("ResearchProgressTrackerUniversity")
  researchProgressStatusHistorys        ResearchProgressStatusHistory[]        @relation("ResearchProgressStatusHistoryUniversity")
  researchProfileIdentitys              ResearchProfileIdentity[]              @relation("ResearchProfileIdentityUniversity")
  publicationImportRuns                 PublicationImportRun[]                 @relation("PublicationImportRunUniversity")
  publicationImports                    PublicationImport[]                    @relation("PublicationImportUniversity")
  grantApplications                     GrantApplication[]                     @relation("GrantApplicationUniversity")
  grantInvestigators                    GrantInvestigator[]                    @relation("GrantInvestigatorUniversity")
  grantApplicationReviews               GrantApplicationReview[]               @relation("GrantApplicationReviewUniversity")
  grantApplicationStatusHistorys        GrantApplicationStatusHistory[]        @relation("GrantApplicationStatusHistoryUniversity")
  grantApplicationEditSuggestions       GrantApplicationEditSuggestion[]       @relation("GrantApplicationEditSuggestionUniversity")
  grantConsortiumOrganizations          GrantConsortiumOrganization[]          @relation("GrantConsortiumOrganizationUniversity")
  departments                           Department[]                           @relation("DepartmentUniversity")
  programs                              Program[]                              @relation("ProgramUniversity")
  programSpecializations                ProgramSpecialization[]                @relation("ProgramSpecializationUniversity")
  sections                              Section[]                              @relation("SectionUniversity")
  studentDetailss                       StudentDetails[]                       @relation("StudentDetailsUniversity")
  employeeDetailss                      EmployeeDetails[]                      @relation("EmployeeDetailsUniversity")
  centralDepartmentPermissions          CentralDepartmentPermission[]          @relation("CentralDepartmentPermissionUniversity")
  departmentPermissions                 DepartmentPermission[]                 @relation("DepartmentPermissionUniversity")
  userDepartmentPermissions             UserDepartmentPermission[]             @relation("UserDepartmentPermissionUniversity")
  reportingStructures                   ReportingStructure[]                   @relation("ReportingStructureUniversity")
  bugReportScreenshots                  BugReportScreenshot[]                  @relation("BugReportScreenshotUniversity")
  reissueRequests                       ReissueRequest[]                       @relation("ReissueRequestUniversity")
  cards                                 Card[]                                 @relation("CardUniversity")
  documentChanges                       DocumentChange[]                       @relation("DocumentChangeUniversity")
  changeHistorys                        ChangeHistory[]                        @relation("ChangeHistoryUniversity")
  auditReportConfigs                    AuditReportConfig[]                    @relation("AuditReportConfigUniversity")
  auditReportHistorys                   AuditReportHistory[]                   @relation("AuditReportHistoryUniversity")
  consentNotices                        ConsentNotice[]
  consentRecords                        ConsentRecord[]
  dataPrincipalRequests                 DataPrincipalRequest[]
  dataBreachIncidents                   DataBreachIncident[]
  dataRetentionPolicies                 DataRetentionPolicy[]
  nominees                              DataPrincipalNominee[]
  ripKeywords                           RipResearchKeyword[]                   @relation("RipResearchKeywordUniversity")
  ripContributionKeywords               RipContributionKeyword[]               @relation("RipContributionKeywordUniversity")
  ripTaxonomyDomains                    RipTaxonomyDomain[]                    @relation("RipTaxonomyDomainUniversity")
  ripTaxonomyCategories                 RipTaxonomyCategory[]                  @relation("RipTaxonomyCategoryUniversity")
  ripTaxonomySpecializations            RipTaxonomySpecialization[]            @relation("RipTaxonomySpecializationUniversity")
  ripKeywordTaxonomyMappings            RipKeywordTaxonomyMapping[]            @relation("RipKeywordTaxonomyMappingUniversity")
  ripResearcherTopicScores              RipResearcherTopicScore[]              @relation("RipResearcherTopicScoreUniversity")
  ripExpertiseProfiles                  RipResearcherExpertiseProfile[]        @relation("RipResearcherExpertiseProfileUniversity")
  ripAiCache                            RipAiCache[]                           @relation("RipAiCacheUniversity")
  ripChatSessions                       RipChatSession[]                       @relation("RipChatSessionUniversity")
  ripChatMessages                       RipChatMessage[]                       @relation("RipChatMessageUniversity")
  ripPipelineRuns                       RipPipelineRun[]                       @relation("RipPipelineRunUniversity")
  ripUserAccess                         RipUserAccess[]                        @relation("RipUserAccessUniversity")
  modules                               UniversityModule[]                     @relation("UniversityModuleUniversity")
  incentivePayouts                      IncentivePayout[]                      @relation("IncentivePayoutUniversity")
  payoutBatches                         PayoutBatch[]                          @relation("PayoutBatchUniversity")
  incentivePayoutEvents                 IncentivePayoutEvent[]                 @relation("IncentivePayoutEventUniversity")
  grantFundReceipts                     GrantFundReceipt[]                     @relation("GrantFundReceiptUniversity")
  researchBudgets                       ResearchBudget[]                       @relation("ResearchBudgetUniversity")
  incentiveCycles                       IncentiveCycle[]                       @relation("IncentiveCycleUniversity")
  financeSettings                       FinanceSettings?                       @relation("FinanceSettingsUniversity")
  budgetAllocations                     BudgetAllocation[]                     @relation("BudgetAllocationUniversity")
  budgetAllocationEvents                BudgetAllocationEvent[]                @relation("BudgetAllocationEventUniversity")

  @@map("universities")
}

model SaaSTier {
  id                  String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                String   @unique @db.VarChar(64)
  displayName         String   @map("display_name") @db.VarChar(128)
  monthlyPriceCents   Int      @map("monthly_price_cents")
  yearlyPriceCents    Int      @map("yearly_price_cents")
  maxUsers            Int      @map("max_users")
  maxApiCallsPerMonth Int      @map("max_api_calls_per_month")
  maxStorageGb        Int      @default(10) @map("max_storage_gb")
  features            Json     @default("{}")
  overagePer1kCalls   Int      @default(10) @map("overage_per_1k_calls")
  isPublic            Boolean  @default(true) @map("is_public")
  sortOrder           Int      @default(0) @map("sort_order")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions UniversitySubscription[]

  @@map("saas_tiers")
}

model UniversitySubscription {
  id                 String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  universityId       String   @unique @map("university_id") @db.Uuid
  tierId             String   @map("tier_id") @db.Uuid
  status             String   @default("trialing") @db.VarChar(32)
  billingCycle       String   @default("monthly") @map("billing_cycle") @db.VarChar(16)
  currentPeriodStart DateTime @map("current_period_start") @db.Date
  currentPeriodEnd   DateTime @map("current_period_end") @db.Date
  cancelAtPeriodEnd  Boolean  @default(false) @map("cancel_at_period_end")
  externalPaymentId  String?  @map("external_payment_id") @db.VarChar(256)
  metadata           Json     @default("{}")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  tier       SaaSTier   @relation(fields: [tierId], references: [id])

  @@map("university_subscriptions")
}

model ApiUsageDaily {
  id                  String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  universityId        String   @map("university_id") @db.Uuid
  date                DateTime @db.Date
  totalRequests       Int      @default(0) @map("total_requests")
  successRequests     Int      @default(0) @map("success_requests")
  errorRequests       Int      @default(0) @map("error_requests")
  avgDurationMs       Int      @default(0) @map("avg_duration_ms")
  p95DurationMs       Int      @default(0) @map("p95_duration_ms")
  uniqueUsers         Int      @default(0) @map("unique_users")
  billableUnits       Int      @default(0) @map("billable_units")
  billableAmountCents Int      @default(0) @map("billable_amount_cents")
  endpointBreakdown   Json     @default("{}") @map("endpoint_breakdown")
  computedAt          DateTime @default(now()) @map("computed_at") @db.Timestamptz(6)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@unique([universityId, date])
  @@index([date])
  @@index([universityId, date])
  @@map("api_usage_daily")
}

model UserLogin {
  id                                  String                               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  uid                                 String                               @unique @db.VarChar(32)
  email                               String?                              @unique @db.Citext
  phone                               String?                              @db.VarChar(20)
  profileImageFilePath                String?                              @map("profile_image_file_path")
  profileImage                        String?                              @map("profile_image") @db.VarChar(64)
  passwordHash                        String                               @map("password_hash")
  role                                UserRoleEnum
  assignedRoleIds                     Json?                                @default("[]") @map("assigned_role_ids")
  status                              String                               @default("active") @db.VarChar(32)
  universityId                        String?                              @map("university_id") @db.Uuid
  // Incremented to revoke every JWT issued before (logout-all, password change, deactivation)
  tokenVersion                        Int                                  @default(0) @map("token_version")
  failedLoginAttempts                 Int                                  @default(0) @map("failed_login_attempts")
  lockedUntil                         DateTime?                            @map("locked_until") @db.Timestamptz(6)
  passwordChangedAt                   DateTime?                            @map("password_changed_at") @db.Timestamptz(6)
  // DPDP: set when personal data has been erased/anonymised on a data principal request
  anonymizedAt                        DateTime?                            @map("anonymized_at") @db.Timestamptz(6)
  lastLoginAt                         DateTime?                            @map("last_login_at") @db.Timestamptz(6)
  createdAt                           DateTime                             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                           DateTime                             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  university                          University?                          @relation(fields: [universityId], references: [id])
  auditLogs                           AuditLog[]
  createdBookChapterPolicies          BookChapterIncentivePolicy[]         @relation("BookChapterPolicyCreatedBy")
  updatedBookChapterPolicies          BookChapterIncentivePolicy[]         @relation("BookChapterPolicyUpdatedBy")
  createdBookPolicies                 BookIncentivePolicy[]                @relation("BookPolicyCreatedBy")
  updatedBookPolicies                 BookIncentivePolicy[]                @relation("BookPolicyUpdatedBy")
  cardsIssued                         Card[]                               @relation("IssuedBy")
  headOfCentralDepts                  CentralDepartment[]                  @relation("HeadOfCentralDepartment")
  assignedCentralDeptPerms            CentralDepartmentPermission[]        @relation("AssignedCentralDeptPermissions")
  centralDeptPermissions              CentralDepartmentPermission[]        @relation("UserCentralDeptPermissions")
  changesHistory                      ChangeHistory[]
  createdConferencePolicies           ConferenceIncentivePolicy[]          @relation("ConferencePolicyCreatedBy")
  updatedConferencePolicies           ConferenceIncentivePolicy[]          @relation("ConferencePolicyUpdatedBy")
  headOfDepartments                   Department[]                         @relation("HeadOfDepartment")
  assignedSchoolDeptPerms             DepartmentPermission[]               @relation("AssignedDepartmentPermissions")
  schoolDeptPermissions               DepartmentPermission[]               @relation("UserDepartmentPermissions")
  documentChangeReviews               DocumentChange[]                     @relation("DocumentChangeReviewer")
  employeeDetails                     EmployeeDetails?
  headOfFaculties                     FacultySchoolList[]                  @relation("HeadOfFaculty")
  grantApplications                   GrantApplication[]                   @relation("GrantApplications")
  grantApplicationEditSuggestions     GrantApplicationEditSuggestion[]     @relation("GrantApplicationEditSuggestions")
  grantApplicationReviews             GrantApplicationReview[]             @relation("GrantApplicationReviews")
  grantApplicationStatusChanges       GrantApplicationStatusHistory[]      @relation("GrantApplicationStatusChanges")
  createdGrantPolicies                GrantIncentivePolicy[]               @relation("GrantPolicyCreatedBy")
  updatedGrantPolicies                GrantIncentivePolicy[]               @relation("GrantPolicyUpdatedBy")
  grantInvestigators                  GrantInvestigator[]                  @relation("GrantInvestigators")
  createdIncentivePolicies            IncentivePolicy[]                    @relation("IncentivePolicyCreatedBy")
  updatedIncentivePolicies            IncentivePolicy[]                    @relation("IncentivePolicyUpdatedBy")
  approvedIPRs                        IPR[]                                @relation("IPRApprover")
  createdIPRs                         IPR[]                                @relation("IPRCreator")
  iprApplications                     IprApplication[]                     @relation("IprApplications")
  iprCollaborativeSessions            IprCollaborativeSession[]            @relation("IprCollaborativeSessions")
  iprContributions                    IprContributor[]                     @relation("IprContributors")
  iprEditSuggestions                  IprEditSuggestion[]                  @relation("IprEditSuggestions")
  iprFinanceReviews                   IprFinance[]                         @relation("IprFinanceReviews")
  iprReviews                          IprReview[]                          @relation("IprReviews")
  iprStatusChanges                    IprStatusHistory[]                   @relation("IprStatusChanges")
  iprStatusUpdates                    IprStatusUpdate[]                    @relation("IprStatusUpdates")
  notifications                       Notification[]                       @relation("UserNotifications")
  programCoordinators                 Program[]                            @relation("ProgramCoordinator")
  reissueRequestsApproved             ReissueRequest[]                     @relation("ApprovedBy")
  reissueRequestsMade                 ReissueRequest[]                     @relation("RequestedBy")
  researchContributions               ResearchContribution[]               @relation("ResearchContributions")
  researchContributionAuthorship      ResearchContributionAuthor[]         @relation("ResearchContributionAuthors")
  researchContributionEditSuggestions ResearchContributionEditSuggestion[] @relation("ResearchContributionEditSuggestions")
  researchContributionReviews         ResearchContributionReview[]         @relation("ResearchContributionReviews")
  researchContributionStatusChanges   ResearchContributionStatusHistory[]  @relation("ResearchContributionStatusChanges")
  researchProfileIdentity             ResearchProfileIdentity?             @relation("UserResearchProfileIdentity")
  triggeredPublicationImportRuns      PublicationImportRun[]               @relation("PublicationImportRunTriggeredBy")
  createdResearchPolicies             ResearchIncentivePolicy[]            @relation("ResearchPolicyCreatedBy")
  updatedResearchPolicies             ResearchIncentivePolicy[]            @relation("ResearchPolicyUpdatedBy")
  researchProgressTrackers            ResearchProgressTracker[]            @relation("ResearchProgressTrackers")
  classTeachers                       Section[]                            @relation("ClassTeacher")
  approvedStudents                    StudentDetails[]                     @relation("DataApprovedBy")
  mentoredStudents                    StudentDetails[]                     @relation("StudentMentor")
  studentLogin                        StudentDetails?                      @relation("StudentLogin")
  assignedDepartmentPermissions       UserDepartmentPermission[]           @relation("AssignedBy")
  departmentPermissions               UserDepartmentPermission[]
  userSettings                        UserSettings?                        @relation("UserSettings")
  // Chat System Relations

  // Mail System Relations
  reportingStructure           ReportingStructure[]           @relation("UserReporting")
  directReports                ReportingStructure[]           @relation("ManagerReporting")
  // TMS Relations
  bugReportsCreated            BugReport[]                    @relation("BugReportUser")
  bugReportsResolved           BugReport[]                    @relation("BugReportResolver")
  consentRecords               ConsentRecord[]                @relation("ConsentRecordUser")
  dataPrincipalRequests        DataPrincipalRequest[]         @relation("DataPrincipalRequestUser")
  handledDataPrincipalRequests DataPrincipalRequest[]         @relation("DataPrincipalRequestHandler")
  reportedBreaches             DataBreachIncident[]           @relation("DataBreachReporter")
  nominee                      DataPrincipalNominee?          @relation("DataPrincipalNomineeUser")
  ripChatSessions              RipChatSession[]               @relation("RipChatSessions")
  ripExpertiseProfile          RipResearcherExpertiseProfile? @relation("RipExpertiseProfile")
  ripTopicScores               RipResearcherTopicScore[]      @relation("RipTopicScores")
  ripAccess                    RipUserAccess?                 @relation("RipUserAccess")
  incentivePayouts             IncentivePayout[]              @relation("PayoutPayee")
  recommendedPayouts           IncentivePayout[]              @relation("PayoutRecommendedBy")
  createdPayoutBatches         PayoutBatch[]                  @relation("PayoutBatchCreatedBy")
  approvedPayoutBatches        PayoutBatch[]                  @relation("PayoutBatchApprovedBy")
  paidPayoutBatches            PayoutBatch[]                  @relation("PayoutBatchPaidBy")
  payoutEvents                 IncentivePayoutEvent[]         @relation("PayoutEventActor")
  recordedGrantReceipts        GrantFundReceipt[]             @relation("GrantReceiptRecordedBy")
  researchBudgetsCreated       ResearchBudget[]               @relation("ResearchBudgetCreatedBy")
  researchBudgetsUpdated       ResearchBudget[]               @relation("ResearchBudgetUpdatedBy")
  incentiveCyclesCreated       IncentiveCycle[]               @relation("IncentiveCycleCreatedBy")
  incentiveCyclesUpdated       IncentiveCycle[]               @relation("IncentiveCycleUpdatedBy")
  financeSettingsUpdated       FinanceSettings[]              @relation("FinanceSettingsUpdatedBy")
  budgetAllocationsUpdated     BudgetAllocation[]             @relation("BudgetAllocationUpdatedBy")
  budgetAllocationEvents       BudgetAllocationEvent[]        @relation("BudgetAllocationEventActor")

  @@index([universityId])
  @@map("user_login")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  token     String    @unique @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

model EmployeeDetails {
  id                   String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  universityId         String             @map("university_id") @db.Uuid
  university           University         @relation("EmployeeDetailsUniversity", fields: [universityId], references: [id], onDelete: Restrict)
  userLoginId          String?            @unique @map("user_login_id") @db.Uuid
  firstName            String             @map("first_name") @db.VarChar(128)
  lastName             String?            @map("last_name") @db.VarChar(128)
  displayName          String?            @map("display_name") @db.VarChar(256)
  photoFilePath        String?            @map("photo_file_path")
  photo                String?            @db.VarChar(64)
  empId                String?            @map("emp_id") @db.VarChar(64)
  designation          String?            @db.VarChar(128)
  joinDate             DateTime?          @map("join_date") @db.Date
  isActive             Boolean            @default(true) @map("is_active")
  metadata             Json               @default("{}")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  primaryCentralDeptId String?            @map("primary_central_dept_id") @db.Uuid
  primaryDepartmentId  String?            @map("primary_department_id") @db.Uuid
  email                String?            @db.VarChar(256)
  phoneNumber          String?            @map("phone_number") @db.VarChar(20)
  primarySchoolId      String?            @map("primary_school_id") @db.Uuid
  officerLevel         String?            @map("officer_level") @db.VarChar(10)
  cards                Card[]
  primaryCentralDept   CentralDepartment? @relation("PrimaryCentralDepartment", fields: [primaryCentralDeptId], references: [id])
  primaryDepartment    Department?        @relation("PrimaryDepartment", fields: [primaryDepartmentId], references: [id])
  primarySchool        FacultySchoolList? @relation("PrimarySchool", fields: [primarySchoolId], references: [id])
  userLogin            UserLogin?         @relation(fields: [userLoginId], references: [id])
  reissueRequests      ReissueRequest[]

  @@unique([universityId, empId])
  @@index([empId])
  @@index([primarySchoolId])
  @@index([primaryDepartmentId])
  @@index([displayName])
  @@index([firstName])
  @@index([lastName])
  @@index([universityId])
  @@map("employee_details")
}

model Card {
  id                  String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  universityId        String           @map("university_id") @db.Uuid
  university          University       @relation("CardUniversity", fields: [universityId], references: [id], onDelete: Restrict)
  cardHolderType      String           @map("card_holder_type") @db.VarChar(32)
  employeeId          String?          @map("employee_id") @db.Uuid
  studentId           String?          @map("student_id") @db.Uuid
  parentId            String?          @map("parent_id") @db.Uuid
  rfidUid             String?          @unique @map("rfid_uid") @db.VarChar(128)
  rfidApproved        Boolean          @default(false) @map("rfid_approved")
  rfidReissue         Boolean          @default(false) @map("rfid_reissue")
  rfidReissueCount    Int              @default(0) @map("rfid_reissue_count")
  rfidUpdatedetail    Boolean          @default(false) @map("rfid_updatedetail")
  rfidImage           String?          @map("rfid_image") @db.VarChar(64)
  rfidIssueImages     String?          @map("rfid_issue_images") @db.VarChar(64)
  latestImageFilePath String?          @map("latest_image_file_path")
  photoFilePath       String?          @map("photo_file_path")
  photo               String?          @db.VarChar(64)
  templateColorCode   String?          @map("template_color_code") @db.VarChar(32)
  issuedAt            DateTime?        @map("issued_at") @db.Timestamptz(6)
  expiresAt           DateTime?        @map("expires_at") @db.Timestamptz(6)
