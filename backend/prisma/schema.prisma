// Software License Protection
// =====================================

/// Hardware-bound license record with explicit admin approval control.
/// Each license key is issued by the developer and requires explicit approval
/// or hardware binding. Set isActive = false to revoke access instantly.
model License {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  licenseKey         String    @unique @map("license_key") @db.VarChar(128)
  assignedTo         String    @map("assigned_to") @db.VarChar(256)
  hardwareId         String?   @map("hardware_id") @db.VarChar(128)
  allowedHardwareIds String[]  @default([]) @map("allowed_hardware_ids")
  pendingHardwareId  String?   @map("pending_hardware_id") @db.VarChar(128)
  requiresApproval   Boolean   @default(true) @map("requires_approval")
  isActive           Boolean   @default(true) @map("is_active")
  notes              String?   @db.Text
  activatedAt        DateTime? @map("activated_at") @db.Timestamptz(6)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([licenseKey])
  @@index([isActive])
  @@map("licenses")
}

