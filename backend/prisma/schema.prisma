  userEmail        String?          @map("user_email") @db.VarChar(255)
  description      String           @db.Text
  pageUrl          String           @map("page_url") @db.VarChar(2048)
  routePath        String           @map("route_path") @db.VarChar(512)
  resolutionStatus ResolutionStatus @default(unresolved) @map("resolution_status")
  resolvedAt       DateTime?        @map("resolved_at") @db.Timestamptz(6)
  resolvedBy       String?          @map("resolved_by") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        UserLogin             @relation("BugReportUser", fields: [userId], references: [id], onDelete: Cascade)
  resolver    UserLogin?            @relation("BugReportResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)
  university  University?           @relation(fields: [universityId], references: [id])
  screenshots BugReportScreenshot[]

  @@index([userId])
  @@index([createdAt])
  @@index([resolutionStatus])
  @@index([resolvedBy])
  @@index([universityId])
  @@map("bug_reports")
}

