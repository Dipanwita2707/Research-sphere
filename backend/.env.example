# ─────────────────────────────────────────────────────────────────────────────
# ResearchSphere backend environment. Copy to .env and fill in.
# Never commit real values. Placeholders below are safe examples only.
# Optional variables are commented out and show their default.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
# development | test | production (production enables strict checks)
NODE_ENV=development
# HTTP port of the API
PORT=5001
# API path version: routes are mounted at /api/<version>
API_VERSION=v1
# Public URL of the frontend (links in emails, CORS fallback)
FRONTEND_URL=http://localhost:3000
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000
# Domain used when validating URLs in bug reports
# APP_DOMAIN=sgt-ums.local
# winston log level: error | warn | info | debug
# LOG_LEVEL=info
# HTTP request logging (default: on in development, off in production)
# ENABLE_REQUEST_LOG=false
# Rate limit window in minutes and max requests per window per IP
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=500
# Recipient of the public contact form
# CONTACT_EMAIL=admin@example.com

# ── Database (PostgreSQL / Neon) ─────────────────────────────────────────────
# Connection string. For `prisma migrate deploy`, use the direct (non-pooler) host.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
# Prisma pool size per process (per PM2 worker) and pool wait timeout in seconds
DB_POOL_SIZE=12
DB_POOL_TIMEOUT=30
# Legacy pool hints, still read by app.config
# DB_POOL_MIN=20
# DB_POOL_MAX=100
# Log queries slower than this many ms (non-production only)
# SLOW_QUERY_MS=500
# Reserved: periodic DB ping to keep Neon compute awake (not read by the current code)
# DB_KEEPALIVE=false

# ── Auth / JWT / cookies ─────────────────────────────────────────────────────
# REQUIRED in production, at least 32 random characters.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Token lifetime (jsonwebtoken format) and auth cookie lifetime in days
JWT_EXPIRE=1d
JWT_COOKIE_EXPIRE=1
# SameSite for the auth cookie: lax | strict | none (none requires HTTPS)
COOKIE_SAMESITE=lax
# bcrypt cost factor
BCRYPT_ROUNDS=10

# ── Security ─────────────────────────────────────────────────────────────────
# Failed logins before an account is locked, and the lockout duration in minutes
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15

# ── Licensing (DRM) ──────────────────────────────────────────────────────────
# Licence key issued from Superadmin -> Licenses. Leave empty (or set
# LOCAL_DEV_WHITELISTED) together with LICENSE_WHITELIST_LOCAL=true for local dev.
LICENSE_KEY=
# true = skip remote verification when LICENSE_KEY is empty/LOCAL_DEV_WHITELISTED (dev only)
LICENSE_WHITELIST_LOCAL=true
# Licence verification endpoint
LICENSE_SERVER_URL=https://researchsphere.tech/api/v1/license/verify
# Timeout of a verification call in ms
LICENSE_TIMEOUT_MS=10000
# Periodic re-verification interval in ms (default 6 h), so revocation applies without restart
# LICENSE_RECHECK_MS=21600000
# HMAC salt for hardware fingerprints (must match the licence server)
LICENSE_SALT=change-me-random-salt
# Licence server only: HMAC salt for runtime secrets (required in production on the licence server)
# LICENSE_MASTER_SALT=change-me-random-master-salt

# ── Tenancy / subscriptions ──────────────────────────────────────────────────
# Days a tenant may keep using the app after currentPeriodEnd before access is blocked
SUBSCRIPTION_GRACE_DAYS=7

# ── Cache / Redis ────────────────────────────────────────────────────────────
# memory = in-process cache only (single instance / dev). Unset = use Redis when configured.
# CACHE_MODE=memory
# Either a URL...
# REDIS_URL=redis://localhost:6379
# ...or discrete settings
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_DB=0

# ── Email ────────────────────────────────────────────────────────────────────
# SMTP (nodemailer). EMAIL_USER/EMAIL_PASS take precedence over SMTP_USER/SMTP_PASS.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=no-reply@example.com
EMAIL_PASS=change-me-smtp-app-password
# SMTP_USER=
# SMTP_PASS=
# Sender identity
EMAIL_FROM_NAME=ResearchSphere
EMAIL_FROM_ADDRESS=no-reply@example.com
# EMAIL_FROM=no-reply@example.com
# Organisation name used in email templates
# EMAIL_ORG_NAME=ResearchSphere
# SendGrid (optional transactional provider; used when the key is set)
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=no-reply@example.com

# ── Storage (AWS S3) ─────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Bucket for uploads (shared/utils/s3.js)
S3_BUCKET_NAME=your-bucket
# Bucket used by core s3.service (may be the same bucket)
AWS_S3_BUCKET=your-bucket

# ── Background jobs ──────────────────────────────────────────────────────────
# Cron schedulers run only on PM2 instance 0 and only when RUN_JOBS is not "false".
# Set RUN_JOBS=false on extra web-only replicas.
RUN_JOBS=true
# Daily API usage aggregation
# API_USAGE_ENABLED=true
# API_USAGE_CRON=30 0 * * *
# Nightly publication sync (Scopus / OpenAlex / ORCID)
# PUBLICATION_SYNC_ENABLED=true
# PUBLICATION_SYNC_CRON=0 2 * * *
# Workflow health monitor thresholds in days
# WORKFLOW_MONITOR_STUCK_REVIEW_DAYS=7
# WORKFLOW_MONITOR_STUCK_SUBMISSION_DAYS=14

# ── Research data sources ────────────────────────────────────────────────────
SCOPUS_API_KEY=
# SCOPUS_API_BASE_URL=https://api.elsevier.com/content
# SCOPUS_SEARCH_PAGE_SIZE=25
# OPENALEX_API_KEY=
# OPENALEX_API_BASE_URL=https://api.openalex.org
# ORCID_ACCESS_TOKEN=
# ORCID_API_BASE_URL=https://pub.orcid.org/v3.0

# ── Research intelligence (AI) ───────────────────────────────────────────────
# GEMINI_API_KEY=
# GROQ_API_KEY=
# RIP_GEMINI_MODEL=
# RIP_GROQ_MODEL=
# RIP_GEMINI_THINKING_BUDGET=
# AI call timeout in ms, and chat requests per window per user
# RIP_AI_TIMEOUT_MS=90000
# RIP_CHAT_RATE_LIMIT=30
# RIP_PIPELINE_ENABLED=true
# RIP_PIPELINE_CRON=30 3 * * *

# ── DPDP Act 2023 ────────────────────────────────────────────────────────────
# Days within which a data principal request must be resolved
DPDP_REQUEST_SLA_DAYS=30
# Nightly retention job: enable flag, schedule, and dry run (true = only count what it would erase/anonymise)
# DPDP_RETENTION_ENABLED=true
# DPDP_RETENTION_CRON=15 2 * * *
DPDP_RETENTION_DRY_RUN=true
# Rows anonymised per retention batch
# DPDP_RETENTION_ANONYMISE_BATCH=200
# Emails sent per batch when notifying a data breach
# DPDP_BREACH_EMAIL_BATCH=50
# Base URL of the guardian consent page (default: FRONTEND_URL + /guardian-consent)
# DPDP_GUARDIAN_CONSENT_URL=http://localhost:3000/guardian-consent
# Guardian consent requests per window per IP
# DPDP_GUARDIAN_RATE_LIMIT=20

# ── Seeds (development / bootstrap only) ─────────────────────────────────────
# Password for accounts created by `npm run seed` (unset = random, printed once). Min 12 chars.
# SEED_DEFAULT_PASSWORD=
# Password for `npm run seed:superadmin` (unset = random, printed once). Min 12 chars.
# SUPERADMIN_PASSWORD=
# SUPERADMIN_UID=SUPER001
# SUPERADMIN_EMAIL=ops@example.com

# ── Tests ────────────────────────────────────────────────────────────────────
# 1 = also run DB / integration suites (tenant isolation test rolls back)
# RUN_DB_TESTS=0
# TEST_API_URL=http://localhost:5001
# TEST_ADMIN_UID=
# TEST_STUDENT_UID=

# Research Intelligence (AI research assistant, topic taxonomy, expertise)
# At least one key enables the AI features; Gemini is primary, Groq the fallback.
GEMINI_API_KEY=
GROQ_API_KEY=
RIP_GEMINI_MODEL=gemini-2.5-flash
RIP_GROQ_MODEL=llama-3.3-70b-versatile
# Optional: RIP_GEMINI_THINKING_BUDGET=0, RIP_AI_TIMEOUT_MS=90000, RIP_CHAT_RATE_LIMIT=30 (per user per 5 min)
# Nightly re-index of every university (keywords -> taxonomy -> expertise)
RIP_PIPELINE_ENABLED=true
RIP_PIPELINE_CRON=30 3 * * *
