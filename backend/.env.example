# Server Configuration
NODE_ENV=development
PORT=5000
API_VERSION=v1

# Database Configuration (Prisma uses this)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/sgt_university?schema=public"


# AWS DB URL


# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d
JWT_COOKIE_EXPIRE=7

# Chat JWT Configuration (separate scoped tokens for chat module)
CHAT_JWT_SECRET=your-separate-chat-jwt-secret
CHAT_JWT_ACCESS_EXPIRE=15m
CHAT_JWT_REFRESH_EXPIRE=30d

# Redis (optional - use REDIS_URL for connection string, or REDIS_HOST/REDIS_PORT)
# REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379

# Security
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15

# CORS
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100
# Email Configuration (Nodemailer)
EMAIL_USER=sourav11092002@gmail.com
EMAIL_PASS=your-app-specific-password-here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_FROM_NAME=SGT Research Portal
EMAIL_FROM_ADDRESS=sourav11092002@gmail.com

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─────────────────────────────────────────────────────────────
# Software License & Hardware Protection (DRM)
# ─────────────────────────────────────────────────────────────
# LICENSE_KEY: The UUID license key generated from the Superadmin License UI
# Examples:
#   For client machines (e.g. Sourav's Macbook): 9e6b6845-6045-4105-xxxx-xxxxxxxxxxxx
#   For local dev bypass: LOCAL_DEV_WHITELISTED
LICENSE_KEY=your-license-key-from-superadmin-or-developer

# LICENSE_WHITELIST_LOCAL: When true, allows running locally in development
# without strict hardware rejection (default is true in dev mode).
LICENSE_WHITELIST_LOCAL=true

# LICENSE_SERVER_URL: The endpoint where the client verifies its license on startup.
# Options:
#   1. Remote/Cloud Hosted: https://sgt-ums-2.onrender.com/api/v1/license/verify
#   2. Local via Ngrok Tunnel: https://your-tunnel-id.ngrok-free.app/api/v1/license/verify
#   3. Local Network (LAN): http://192.168.x.x:5001/api/v1/license/verify
#   4. Same Machine: http://localhost:5001/api/v1/license/verify
LICENSE_SERVER_URL=https://researchsphere.tech/api/v1/license/verify

# LICENSE_SALT: Secret HMAC salt for hashing hardware fingerprints
LICENSE_SALT=sgt_ums_local_dev_salt_2026
LICENSE_TIMEOUT_MS=10000