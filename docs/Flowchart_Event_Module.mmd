    %% Payment Flow
    NEEDS_PAYMENT{{"💳 Payment<br/>Required?"}}
    SHOW_AMOUNT["💵 Show Amount Due"]
    CREATE_ORDER["📝 Create Razorpay Order"]
    RAZORPAY_CHECKOUT["💳 Razorpay Checkout"]
    PAYMENT_STATUS{{"💳 Payment<br/>Status?"}}
    PAYMENT_SUCCESS["✅ Payment Successful"]
    PAYMENT_FAILED["❌ Payment Failed"]
