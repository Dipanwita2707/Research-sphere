    CHECK_EXIT{{"🚪 Has<br/>Entered?"}}
    NOT_ENTERED["⚠️ Not Yet Entered"]
    MARK_EXIT["✅ Mark Exit"]
    
    LOG_SCAN["📜 Log Scan Event"]
    SCAN_RECORDED[("📋 Attendance<br/>Recorded")]
