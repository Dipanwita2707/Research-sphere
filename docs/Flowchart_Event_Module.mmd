    END_FAILED([❌ END - Failed])
    ACCESS_DENIED["❌ Access Denied"]

    %% ═══════════════════════════════════════════════════════════════════
    %% FLOW CONNECTIONS
    %% ═══════════════════════════════════════════════════════════════════

    START --> AUTH
    AUTH -->|No| LOGIN --> AUTH
    AUTH -->|Yes| ROLE
    
    %% Creator Flow
    ROLE -->|Faculty/Staff/Admin| CREATOR_ACTIONS
    CREATOR_ACTIONS -->|From Noting| FROM_NOTING --> EVENT_AUTO_CREATED --> CONFIGURE_EVENT
    CREATOR_ACTIONS -->|Configure| CONFIGURE_EVENT
    
    CONFIGURE_EVENT --> CONFIG_VISIBILITY --> VIS_TYPE
    VIS_TYPE -->|All| VIS_ALL --> SAVE_VISIBILITY
    VIS_TYPE -->|Role| VIS_ROLE --> SAVE_VISIBILITY
    VIS_TYPE -->|Filter| VIS_FILTER --> SAVE_VISIBILITY
    
    SAVE_VISIBILITY --> CONFIG_REGISTRATION --> REG_TYPE
    REG_TYPE -->|Auto| AUTO_APPROVE --> TEAM_BASED
    REG_TYPE -->|Manual| MANUAL_APPROVE --> TEAM_BASED
    
    TEAM_BASED -->|Yes| TEAM_CONFIG --> EXTRA_PASSES
    TEAM_BASED -->|No| EXTRA_PASSES
    EXTRA_PASSES -->|Yes| PASS_CONFIG --> ADD_CUSTOM_FIELDS
    EXTRA_PASSES -->|No| ADD_CUSTOM_FIELDS
    
    ADD_CUSTOM_FIELDS -->|Yes| CREATE_FIELD --> FIELD_CONFIG --> REORDER_FIELDS --> PAYMENT_TYPE
    ADD_CUSTOM_FIELDS -->|No| PAYMENT_TYPE
    
    PAYMENT_TYPE -->|Free| FREE_EVENT --> SETUP_COUPONS
    PAYMENT_TYPE -->|Paid| PAID_EVENT --> SET_FEE --> SETUP_COUPONS
    
    SETUP_COUPONS -->|Yes| CREATE_COUPON --> COUPON_CONFIG --> SETUP_PRIZES
    SETUP_COUPONS -->|No| SETUP_PRIZES
    
    SETUP_PRIZES -->|Yes| ADD_PRIZE --> PRIZE_CONFIG --> SETUP_CERT
    SETUP_PRIZES -->|No| SETUP_CERT
    
    SETUP_CERT -->|Yes| CREATE_TEMPLATE --> UPLOAD_TEMPLATE --> CONFIGURE_FIELDS --> IS_STALL_EVENT
    SETUP_CERT -->|No| IS_STALL_EVENT
    
    IS_STALL_EVENT -->|Yes| STALL_CONFIG --> STALL_TYPE
    STALL_TYPE -->|Student| STUDENT_STALLS --> STALL_FEE --> ASSIGN_VOLUNTEERS
    STALL_TYPE -->|Creator| CREATOR_STALLS --> STALL_FEE
    IS_STALL_EVENT -->|No| ASSIGN_VOLUNTEERS
    
    ASSIGN_VOLUNTEERS -->|Yes| SELECT_VOLUNTEER --> VOL_CONFIG --> PUBLISH_EVENT
    ASSIGN_VOLUNTEERS -->|No| PUBLISH_EVENT
    
    PUBLISH_EVENT --> VALIDATE_EVENT --> VALID_CONFIG
    VALID_CONFIG -->|No| SHOW_ERRORS --> CONFIGURE_EVENT
    VALID_CONFIG -->|Yes| SET_PUBLISHED --> EVENT_LIVE --> END_SUCCESS
    
    %% Student Flow
    ROLE -->|Student| STUDENT_ACTIONS
    STUDENT_ACTIONS -->|Browse| BROWSE_EVENTS --> APPLY_EVENT_FILTERS --> CHECK_VISIBILITY --> CAN_VIEW
    CAN_VIEW -->|No| ACCESS_DENIED --> END_FAILED
    CAN_VIEW -->|Yes| EVENTS_LIST --> VIEW_EVENT_DETAILS
    
    STUDENT_ACTIONS -->|Register| REGISTER_EVENT --> CHECK_ELIGIBLE
    CHECK_ELIGIBLE -->|No| NOT_ELIGIBLE --> END_FAILED
    CHECK_ELIGIBLE -->|Yes| CHECK_CAPACITY
    CHECK_CAPACITY -->|No| WAITLIST_OPT
    WAITLIST_OPT -->|Yes| ADD_WAITLIST --> END_PENDING
    WAITLIST_OPT -->|No| CAPACITY_FULL --> END_FAILED
    CHECK_CAPACITY -->|Yes| IS_TEAM_EVENT
    
    IS_TEAM_EVENT -->|Yes| TEAM_ACTION
    TEAM_ACTION -->|Create| CREATE_TEAM --> TEAM_NAME --> BECOME_LEADER --> TEAM_CREATED --> HAS_CUSTOM_FORM
    TEAM_ACTION -->|Join| JOIN_TEAM --> BROWSE_TEAMS --> TEAM_OPEN
    TEAM_OPEN -->|Yes| SEND_REQUEST --> REQUEST_SENT --> END_PENDING
    TEAM_OPEN -->|No| TEAM_CLOSED --> END_FAILED
    TEAM_ACTION -->|Invite| ACCEPT_INVITE --> JOINED_TEAM --> HAS_CUSTOM_FORM
    
    IS_TEAM_EVENT -->|No| HAS_CUSTOM_FORM
    HAS_CUSTOM_FORM -->|Yes| FILL_FORM --> VALIDATE_FORM --> FORM_VALID
    FORM_VALID -->|No| FORM_ERRORS --> FILL_FORM
    FORM_VALID -->|Yes| HAS_COUPON
    HAS_CUSTOM_FORM -->|No| HAS_COUPON
    
    HAS_COUPON -->|Yes| ENTER_COUPON --> VALIDATE_COUPON --> COUPON_VALID
    COUPON_VALID -->|Yes| APPLY_DISCOUNT --> NEEDS_PAYMENT
    COUPON_VALID -->|No| INVALID_COUPON --> NEEDS_PAYMENT
    HAS_COUPON -->|No| NEEDS_PAYMENT
    
    NEEDS_PAYMENT -->|Yes| SHOW_AMOUNT --> CREATE_ORDER --> RAZORPAY_CHECKOUT --> PAYMENT_STATUS
    PAYMENT_STATUS -->|Success| PAYMENT_SUCCESS --> CREATE_REGISTRATION
    PAYMENT_STATUS -->|Failed| PAYMENT_FAILED --> RETRY_PAYMENT
    RETRY_PAYMENT -->|Yes| RAZORPAY_CHECKOUT
    RETRY_PAYMENT -->|No| END_FAILED
    NEEDS_PAYMENT -->|No| CREATE_REGISTRATION
    
    CREATE_REGISTRATION --> GENERATE_QR --> SET_REG_STATUS
    SET_REG_STATUS -->|Yes| STATUS_CONFIRMED --> REGISTRATION_COMPLETE
    SET_REG_STATUS -->|No| STATUS_PENDING --> REGISTRATION_COMPLETE
    REGISTRATION_COMPLETE --> SEND_CONFIRMATION --> SHOW_TICKET --> END_SUCCESS
    
    STUDENT_ACTIONS -->|Extra Pass| CREATE_EXTRA_PASS
    CREATE_EXTRA_PASS -->|Yes| FILL_GUEST_INFO --> GENERATE_GUEST_QR --> EXTRA_PASS_CREATED --> END_SUCCESS
    
    %% Volunteer Flow
    ROLE -->|Volunteer| VOLUNTEER_ACTIONS
    VOLUNTEER_ACTIONS -->|Scan| QR_SCAN --> DECODE_QR --> VALIDATE_QR
    VALIDATE_QR -->|No| INVALID_QR --> END_FAILED
    VALIDATE_QR -->|Yes| GET_REG_INFO --> CHECK_REG_STATUS
    CHECK_REG_STATUS -->|No| REG_NOT_CONFIRMED --> END_FAILED
    CHECK_REG_STATUS -->|Yes| SCAN_TYPE
    
    SCAN_TYPE -->|Entry| ENTRY_SCAN --> CHECK_ENTRY
    CHECK_ENTRY -->|Yes| ALREADY_ENTERED --> END_FAILED
    CHECK_ENTRY -->|No| MARK_ENTRY --> LOG_SCAN
    
    SCAN_TYPE -->|Exit| EXIT_SCAN --> CHECK_EXIT
    CHECK_EXIT -->|No| NOT_ENTERED --> END_FAILED
    CHECK_EXIT -->|Yes| MARK_EXIT --> LOG_SCAN
    
    LOG_SCAN --> SCAN_RECORDED --> SHOW_SCAN_RESULT --> END_SUCCESS
    
    %% Post-Event Flow
    CREATOR_ACTIONS -->|Post-Event| POST_EVENT_ACTIONS
    POST_EVENT_ACTIONS -->|Feedback| SUBMIT_FEEDBACK --> RATE_EVENT --> ADD_COMMENTS --> FEEDBACK_SUBMITTED --> END_SUCCESS
    POST_EVENT_ACTIONS -->|Certificates| GENERATE_CERTS --> SELECT_RECIPIENTS --> GENERATE_PDF --> UPLOAD_S3 --> SEND_CERT_EMAIL --> CERT_GENERATED --> END_SUCCESS
    POST_EVENT_ACTIONS -->|Analytics| VIEW_ANALYTICS --> ANALYTICS_DATA --> END_SUCCESS
    POST_EVENT_ACTIONS -->|Bulk Email| SEND_BULK_EMAIL --> SELECT_AUDIENCE --> COMPOSE_EMAIL --> SEND_EMAIL --> EMAIL_SENT --> END_SUCCESS
    
    STUDENT_ACTIONS -->|Feedback| SUBMIT_FEEDBACK
    STUDENT_ACTIONS -->|Certificate| DOWNLOAD_CERT --> END_SUCCESS
    
    %% Stall Flow
    STUDENT_ACTIONS -->|Stall| STALL_ACTIONS
    STALL_ACTIONS -->|Apply| APPLY_STALL --> STALL_FORM --> SUBMIT_STALL_APP --> STALL_APP_SUBMITTED --> END_PENDING
    
    CREATOR_ACTIONS -->|Stalls| REVIEW_STALL_APP --> STALL_DECISION
    STALL_DECISION -->|Approve| APPROVE_STALL --> STALL_CREATED --> END_SUCCESS
    STALL_DECISION -->|Reject| REJECT_STALL --> END_FAILED

