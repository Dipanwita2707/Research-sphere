    %% Registration Complete
    CREATE_REGISTRATION["📝 Create Registration"]
    GENERATE_QR["🔲 Generate QR Code"]
    SET_REG_STATUS{{"✅ Auto<br/>Approve?"}}
    STATUS_CONFIRMED["✅ Status: CONFIRMED"]
    STATUS_PENDING["⏳ Status: PENDING"]
    
    REGISTRATION_COMPLETE[("✅ Registration<br/>Complete")]
    SEND_CONFIRMATION["📧 Send Confirmation Email"]
    SHOW_TICKET["🎫 Show QR Ticket"]
    
    %% Extra Pass
    CREATE_EXTRA_PASS{{"🎫 Create Extra<br/>Pass?"}}
    FILL_GUEST_INFO["📝 Guest Info:<br/>• Name<br/>• Email<br/>• Relationship"]
    GENERATE_GUEST_QR["🔲 Generate Guest QR"]
    EXTRA_PASS_CREATED[("🎫 Extra Pass<br/>Created")]
    
    %% ═══════════════════════════════════════════════════════════════════
    %% VOLUNTEER FLOW - QR Scanning
    %% ═══════════════════════════════════════════════════════════════════
    
    VOLUNTEER_ACTIONS{{"🙋 Volunteer<br/>Action?"}}
    
    QR_SCAN["📱 Scan QR Code"]
    DECODE_QR["🔍 Decode QR Data"]
    VALIDATE_QR{{"✅ Valid<br/>QR Code?"}}
    INVALID_QR["❌ Invalid QR Code"]
    
    GET_REG_INFO["📋 Get Registration Info"]
    CHECK_REG_STATUS{{"✅ Registration<br/>Confirmed?"}}
    REG_NOT_CONFIRMED["⚠️ Registration Not Confirmed"]
    
    SCAN_TYPE{{"📍 Scan<br/>Type?"}}
    ENTRY_SCAN["➡️ Entry Scan"]
    EXIT_SCAN["⬅️ Exit Scan"]
    
    CHECK_ENTRY{{"🚪 Already<br/>Entered?"}}
    ALREADY_ENTERED["⚠️ Already Inside Venue"]
