    HAS_COUPON{{"🏷️ Have<br/>Coupon?"}}
    ENTER_COUPON["🏷️ Enter Coupon Code"]
    VALIDATE_COUPON["✅ Validate Coupon"]
    COUPON_VALID{{"✅ Coupon<br/>Valid?"}}
