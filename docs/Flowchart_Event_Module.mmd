    class AUTH,ROLE,CREATOR_ACTIONS,VIS_TYPE,REG_TYPE,TEAM_BASED,EXTRA_PASSES,ADD_CUSTOM_FIELDS,PAYMENT_TYPE,SETUP_COUPONS,SETUP_PRIZES,SETUP_CERT,IS_STALL_EVENT,STALL_TYPE,ASSIGN_VOLUNTEERS,VALID_CONFIG,STUDENT_ACTIONS,CAN_VIEW,CHECK_ELIGIBLE,CHECK_CAPACITY,WAITLIST_OPT,IS_TEAM_EVENT,TEAM_ACTION,TEAM_OPEN,HAS_CUSTOM_FORM,FORM_VALID,HAS_COUPON,COUPON_VALID,NEEDS_PAYMENT,PAYMENT_STATUS,RETRY_PAYMENT,SET_REG_STATUS,CREATE_EXTRA_PASS,VOLUNTEER_ACTIONS,VALIDATE_QR,CHECK_REG_STATUS,SCAN_TYPE,CHECK_ENTRY,CHECK_EXIT,POST_EVENT_ACTIONS,STALL_ACTIONS,STALL_DECISION decision
    class EVENT_LIVE,EVENTS_LIST,REGISTRATION_COMPLETE,EXTRA_PASS_CREATED,SCAN_RECORDED,FEEDBACK_SUBMITTED,CERT_GENERATED,ANALYTICS_DATA,EMAIL_SENT,STALL_APP_SUBMITTED,STALL_CREATED,TEAM_CREATED,JOINED_TEAM,REQUEST_SENT data
