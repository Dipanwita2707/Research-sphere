    %% ═══════════════════════════════════════════════════════════════════
    %% DSW MODULE - CLUB MANAGEMENT FLOWCHART
    %% ═══════════════════════════════════════════════════════════════════

    START([🚀 START])
    
    %% ─── Authentication ───
    AUTH{{"🔐 User<br/>Authenticated?"}}
    LOGIN["👤 Login to System"]
    
    %% ─── Role Check ───
    ROLE{{"👤 User Role?"}}
    
    %% ═══════════════════════════════════════════════════════════════════
    %% ADMIN FLOW - Category Management
    %% ═══════════════════════════════════════════════════════════════════
    
    ADMIN_ACTIONS{{"🔐 Admin<br/>Action?"}}
    
    %% Category Management
    CAT_MGMT["📂 Category Management"]
    CAT_ACTION{{"📁 Category<br/>Action?"}}
    VIEW_CATS["👁️ View All Categories"]
    CREATE_CAT["➕ Create New Category"]
    CAT_FORM["📝 Fill Category Form:<br/>• Name<br/>• Description<br/>• Sort Order"]
    SAVE_CAT["💾 Save Category"]
    CAT_SAVED[("✅ Category Saved")]
    UPDATE_CAT["✏️ Update Category"]
    DEACTIVATE_CAT["🗑️ Deactivate Category"]
    CAT_DEACTIVATED[("❌ Category Deactivated")]
    
    %% View Statistics
    VIEW_STATS["📊 View DSW Statistics"]
    FETCH_STATS["🔄 Fetch from Cache/DB"]
    STATS_DATA[("📈 Statistics:<br/>• Total Clubs<br/>• By Category<br/>• By Status<br/>• By Session")]
    DISPLAY_STATS["📊 Display Dashboard"]
    
    %% ═══════════════════════════════════════════════════════════════════
    %% FACULTY FLOW - Club Creation & Management
    %% ═══════════════════════════════════════════════════════════════════
    
    FACULTY_ACTIONS{{"👨‍🏫 Faculty<br/>Action?"}}
    
    %% Create Club (via Noting)
    CREATE_CLUB_NOTING["📝 Create Club via Noting"]
    CLUB_FORM["📋 Fill Club Creation Form:<br/>• Club Name<br/>• Category Selection<br/>• Purpose & Goals<br/>• Target Student Group<br/>• Meeting Frequency<br/>• Expected Activities"]
    
    SELECT_FACILITATOR{{"👨‍🏫 Is Self<br/>Facilitator?"}}
    SELF_FACILITATOR["✅ Set Self as Facilitator"]
    SELECT_OTHER["👤 Select Faculty Facilitator"]
    
    SELECT_CHAIR["👤 Select Student Chairperson"]
    ADD_INITIAL_MEMBERS["👥 Add Initial Members"]
    
    COMPLIANCE_CHECK["☑️ Accept Compliance:<br/>• Code of Conduct<br/>• Anti-Discrimination"]
    
    SUBMIT_NOTING["📤 Submit to Noting System"]
    NOTING_FLOW[["📝 → Noting Approval Workflow"]]
    
    NOTING_APPROVED{{"✅ Noting<br/>Approved?"}}
    CLUB_AUTO_CREATE["🏛️ Club Auto-Created"]
    CLUB_RECORD[("📁 Club Record<br/>in Database")]
    
    NOTING_REJECTED{{"❌ Rejected?"}}
    REVISE_CLUB["✏️ Revise & Resubmit"]
    
    %% Manage Club
    MANAGE_CLUB["🔧 Manage Club"]
    IS_FACILITATOR{{"👨‍🏫 Is<br/>Facilitator?"}}
    
    CLUB_MGMT_ACTION{{"🔧 Management<br/>Action?"}}
    
    %% Update Club
    UPDATE_CLUB["✏️ Update Club Details"]
    FIELD_TYPE{{"📝 Field<br/>Type?"}}
    EDITABLE_FIELD["✅ Edit Directly:<br/>• Email<br/>• Social Media<br/>• Student Strength"]
    SAVE_EDIT["💾 Save Changes"]
    IMMUTABLE_FIELD["🔒 Immutable Field:<br/>Requires Change Request"]
    CREATE_CHANGE_REQ["📝 Create Change Request<br/>(New Noting)"]
    
    %% Member Management
    MEMBER_MGMT["👥 Member Management"]
    MEMBER_ACTION{{"👤 Member<br/>Action?"}}
    
    ADD_MEMBER["➕ Add New Member"]
    SEARCH_STUDENT["🔍 Search Student"]
    SELECT_ROLE["👤 Select Role:<br/>• Chair/Vice Chair<br/>• Secretary/Treasurer<br/>• Core/Tech Lead<br/>• Creative/PR Lead<br/>• Volunteer"]
    CONFIRM_ADD["✅ Confirm Addition"]
    MEMBER_ADDED[("👤 Member Added")]
    LOG_AUDIT["📜 Log to Audit"]
    
    UPDATE_ROLE["✏️ Update Member Role"]
    SELECT_NEW_ROLE["👤 Select New Role"]
    ROLE_UPDATED[("✅ Role Updated")]
    
    REMOVE_MEMBER["➖ Remove Member"]
    CONFIRM_REMOVE{{"⚠️ Confirm<br/>Removal?"}}
    SOFT_DELETE["🗑️ Soft Delete Member<br/>(Mark Inactive)"]
    MEMBER_REMOVED[("❌ Member Removed")]
    
    %% Application Review
    REVIEW_APPS["📋 Review Applications"]
    PENDING_APPS[("📥 Pending<br/>Applications")]
    VIEW_APP["👁️ View Application Details"]
    APP_DECISION{{"📋 Decision?"}}
    APPROVE_APP["✅ Approve Application"]
    REJECT_APP["❌ Reject Application"]
    ADD_REVIEW_NOTE["💬 Add Review Note"]
    APP_STATUS_UPDATE["📝 Update Status"]
    NOTIFY_APPLICANT["📬 Notify Applicant"]
    
    %% View Audit Logs
    VIEW_AUDIT["📜 View Audit Logs"]
    AUDIT_DATA[("📋 Audit Trail:<br/>• Action History<br/>• Performer<br/>• Timestamps<br/>• State Changes")]
    
    %% ═══════════════════════════════════════════════════════════════════
    %% STUDENT FLOW
    %% ═══════════════════════════════════════════════════════════════════
    
    STUDENT_ACTIONS{{"👨‍🎓 Student<br/>Action?"}}
    
    %% Browse Clubs
    BROWSE_CLUBS["👁️ Browse Clubs"]
    APPLY_FILTERS["🔍 Apply Filters:<br/>• Category<br/>• Status<br/>• Search"]
    CLUBS_LIST[("📋 Clubs List")]
    VIEW_CLUB_DETAILS["📄 View Club Details"]
    
    %% Apply to Join
    APPLY_JOIN["📝 Apply to Join Club"]
    IS_MEMBER{{"👤 Already<br/>Member?"}}
    ALREADY_MEMBER["⚠️ Already a Member"]
    
    FILL_APPLICATION["📋 Fill Application:<br/>• Name & Email<br/>• Mobile<br/>• Program/Course<br/>• Why Join?"]
    SUBMIT_APP["📤 Submit Application"]
    APP_SUBMITTED[("✅ Application<br/>Submitted")]
    WAIT_REVIEW["⏳ Wait for Review"]
    
    %% View My Applications
    VIEW_MY_APPS["📋 View My Applications"]
    MY_APPS_LIST[("📋 My Applications:<br/>• Status<br/>• Review Notes")]
    
    %% View My Clubs
    VIEW_MY_CLUBS["🏛️ View My Clubs"]
    MY_CLUBS_LIST[("📋 My Club<br/>Memberships")]
    
    %% Student Club Creation Request
    STU_CREATE_CLUB["📝 Request Club Creation"]
    STU_CLUB_FORM["📋 Fill Club Proposal"]
    STU_SUBMIT["📤 Submit Request"]
    
    %% ═══════════════════════════════════════════════════════════════════
    %% CHAIRPERSON FLOW
    %% ═══════════════════════════════════════════════════════════════════
    
    CHAIR_ACTIONS{{"🎖️ Chairperson<br/>Action?"}}
    CHAIR_MANAGE["🔧 Manage Club Members"]
    CHAIR_REVIEW["📋 Review Applications"]
    CHAIR_UPDATE["✏️ Update Club Info"]
    
    %% ═══════════════════════════════════════════════════════════════════
    %% END STATES
    %% ═══════════════════════════════════════════════════════════════════
    
    END_SUCCESS([✅ END - Success])
    END_PENDING([⏳ END - Pending Approval])
    ACCESS_DENIED["❌ Access Denied"]
    END_DENIED([❌ END - Denied])

    %% ═══════════════════════════════════════════════════════════════════
    %% FLOW CONNECTIONS
    %% ═══════════════════════════════════════════════════════════════════

    START --> AUTH
    AUTH -->|No| LOGIN --> AUTH
    AUTH -->|Yes| ROLE
    
    %% Admin Flow
    ROLE -->|Admin| ADMIN_ACTIONS
    ADMIN_ACTIONS -->|Categories| CAT_MGMT --> CAT_ACTION
    CAT_ACTION -->|View| VIEW_CATS --> END_SUCCESS
    CAT_ACTION -->|Create| CREATE_CAT --> CAT_FORM --> SAVE_CAT --> CAT_SAVED --> END_SUCCESS
    CAT_ACTION -->|Update| UPDATE_CAT --> CAT_FORM
    CAT_ACTION -->|Deactivate| DEACTIVATE_CAT --> CAT_DEACTIVATED --> END_SUCCESS
    
    ADMIN_ACTIONS -->|Statistics| VIEW_STATS --> FETCH_STATS --> STATS_DATA --> DISPLAY_STATS --> END_SUCCESS
    
    %% Faculty Flow
    ROLE -->|Faculty| FACULTY_ACTIONS
    FACULTY_ACTIONS -->|Create Club| CREATE_CLUB_NOTING --> CLUB_FORM --> SELECT_FACILITATOR
    SELECT_FACILITATOR -->|Yes| SELF_FACILITATOR --> SELECT_CHAIR
    SELECT_FACILITATOR -->|No| SELECT_OTHER --> SELECT_CHAIR
    SELECT_CHAIR --> ADD_INITIAL_MEMBERS --> COMPLIANCE_CHECK --> SUBMIT_NOTING --> NOTING_FLOW
    
    NOTING_FLOW --> NOTING_APPROVED
    NOTING_APPROVED -->|Yes| CLUB_AUTO_CREATE --> CLUB_RECORD --> END_SUCCESS
    NOTING_APPROVED -->|No| NOTING_REJECTED
    NOTING_REJECTED -->|Yes| REVISE_CLUB --> CLUB_FORM
    NOTING_REJECTED -->|No| END_PENDING
    
    FACULTY_ACTIONS -->|Manage Club| MANAGE_CLUB --> IS_FACILITATOR
    IS_FACILITATOR -->|No| ACCESS_DENIED --> END_DENIED
    IS_FACILITATOR -->|Yes| CLUB_MGMT_ACTION
    
    CLUB_MGMT_ACTION -->|Update| UPDATE_CLUB --> FIELD_TYPE
    FIELD_TYPE -->|Editable| EDITABLE_FIELD --> SAVE_EDIT --> LOG_AUDIT --> END_SUCCESS
    FIELD_TYPE -->|Immutable| IMMUTABLE_FIELD --> CREATE_CHANGE_REQ --> NOTING_FLOW
    
    CLUB_MGMT_ACTION -->|Members| MEMBER_MGMT --> MEMBER_ACTION
    MEMBER_ACTION -->|Add| ADD_MEMBER --> SEARCH_STUDENT --> SELECT_ROLE --> CONFIRM_ADD --> MEMBER_ADDED --> LOG_AUDIT
    MEMBER_ACTION -->|Update Role| UPDATE_ROLE --> SELECT_NEW_ROLE --> ROLE_UPDATED --> LOG_AUDIT
    MEMBER_ACTION -->|Remove| REMOVE_MEMBER --> CONFIRM_REMOVE
    CONFIRM_REMOVE -->|Yes| SOFT_DELETE --> MEMBER_REMOVED --> LOG_AUDIT
    CONFIRM_REMOVE -->|No| MEMBER_MGMT
    
    CLUB_MGMT_ACTION -->|Applications| REVIEW_APPS --> PENDING_APPS --> VIEW_APP --> APP_DECISION
    APP_DECISION -->|Approve| APPROVE_APP --> ADD_REVIEW_NOTE --> APP_STATUS_UPDATE --> NOTIFY_APPLICANT --> MEMBER_ADDED
    APP_DECISION -->|Reject| REJECT_APP --> ADD_REVIEW_NOTE --> APP_STATUS_UPDATE --> NOTIFY_APPLICANT --> END_SUCCESS
    
    CLUB_MGMT_ACTION -->|Audit| VIEW_AUDIT --> AUDIT_DATA --> END_SUCCESS
    
    %% Student Flow
    ROLE -->|Student| STUDENT_ACTIONS
    STUDENT_ACTIONS -->|Browse| BROWSE_CLUBS --> APPLY_FILTERS --> CLUBS_LIST --> VIEW_CLUB_DETAILS --> END_SUCCESS
    
    STUDENT_ACTIONS -->|Apply| APPLY_JOIN --> IS_MEMBER
    IS_MEMBER -->|Yes| ALREADY_MEMBER --> END_SUCCESS
    IS_MEMBER -->|No| FILL_APPLICATION --> SUBMIT_APP --> APP_SUBMITTED --> WAIT_REVIEW --> END_PENDING
    
    STUDENT_ACTIONS -->|My Apps| VIEW_MY_APPS --> MY_APPS_LIST --> END_SUCCESS
    STUDENT_ACTIONS -->|My Clubs| VIEW_MY_CLUBS --> MY_CLUBS_LIST --> END_SUCCESS
    STUDENT_ACTIONS -->|Create Club| STU_CREATE_CLUB --> STU_CLUB_FORM --> STU_SUBMIT --> NOTING_FLOW
    
    %% Chairperson Flow
    ROLE -->|Chairperson| CHAIR_ACTIONS
    CHAIR_ACTIONS -->|Manage| CHAIR_MANAGE --> MEMBER_ACTION
    CHAIR_ACTIONS -->|Review| CHAIR_REVIEW --> PENDING_APPS
    CHAIR_ACTIONS -->|Update| CHAIR_UPDATE --> FIELD_TYPE

