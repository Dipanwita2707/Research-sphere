    class NOTING_FLOW subprocess
    class LOGIN,CAT_MGMT,VIEW_CATS,CREATE_CAT,CAT_FORM,SAVE_CAT,UPDATE_CAT,DEACTIVATE_CAT,VIEW_STATS,FETCH_STATS,DISPLAY_STATS,CREATE_CLUB_NOTING,CLUB_FORM,SELF_FACILITATOR,SELECT_OTHER,SELECT_CHAIR,ADD_INITIAL_MEMBERS,COMPLIANCE_CHECK,SUBMIT_NOTING,CLUB_AUTO_CREATE,REVISE_CLUB,MANAGE_CLUB,UPDATE_CLUB,EDITABLE_FIELD,SAVE_EDIT,IMMUTABLE_FIELD,CREATE_CHANGE_REQ,MEMBER_MGMT,ADD_MEMBER,SEARCH_STUDENT,SELECT_ROLE,CONFIRM_ADD,LOG_AUDIT,UPDATE_ROLE,SELECT_NEW_ROLE,REMOVE_MEMBER,SOFT_DELETE,REVIEW_APPS,VIEW_APP,APPROVE_APP,REJECT_APP,ADD_REVIEW_NOTE,APP_STATUS_UPDATE,NOTIFY_APPLICANT,VIEW_AUDIT,BROWSE_CLUBS,APPLY_FILTERS,VIEW_CLUB_DETAILS,APPLY_JOIN,FILL_APPLICATION,SUBMIT_APP,WAIT_REVIEW,VIEW_MY_APPS,VIEW_MY_CLUBS,STU_CREATE_CLUB,STU_CLUB_FORM,STU_SUBMIT,CHAIR_MANAGE,CHAIR_REVIEW,CHAIR_UPDATE process
