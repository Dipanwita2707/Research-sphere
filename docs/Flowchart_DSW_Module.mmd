    class AUTH,ROLE,ADMIN_ACTIONS,CAT_ACTION,FACULTY_ACTIONS,SELECT_FACILITATOR,NOTING_APPROVED,NOTING_REJECTED,IS_FACILITATOR,CLUB_MGMT_ACTION,FIELD_TYPE,MEMBER_ACTION,CONFIRM_REMOVE,APP_DECISION,STUDENT_ACTIONS,IS_MEMBER,CHAIR_ACTIONS decision
