    subgraph MASTER_FEATURES["🎛️ MASTER DASHBOARD CORE FEATURES"]
        direction TB
        USER_MGMT["👤 USER MANAGEMENT<br/>- UserLogin profiles & hashes<br/>- Employee & Student details<br/>- Account status control (active/inactive)"]
